//@version=6
indicator("CISD Multi-Timeframe Flow [neo|]", "CISD MTF Flow", overlay = true, max_lines_count = 200, max_labels_count = 200)

// ============================================================================
// INPUTS
// ============================================================================

grpCISD = "CISD Darstellung (Chart-TF)"
bullishBreakColor = input.color(color.new(color.lime, 0), "Bull CISD", inline = "bup", group = grpCISD)
bearishBreakColor = input.color(color.new(color.red, 0), "Bear CISD", inline = "bep", group = grpCISD)
bullStr           = input.string("+CISD", "Text", inline = "bup", group = grpCISD)
bearStr           = input.string("-CISD", "Text", inline = "bep", group = grpCISD)
bullishAlerts     = input.bool(false, "Alert?", inline = "bup", group = grpCISD, tooltip = "Alert wenn der Kurs über das aktuelle '+CISD' Level schließt.")
bearishAlerts     = input.bool(false, "Alert?", inline = "bep", group = grpCISD, tooltip = "Alert wenn der Kurs unter das aktuelle '-CISD' Level schließt.")
lineWidth         = input.int(1, "Line Width", minval = 1, maxval = 5, group = grpCISD)
lookAheadBars     = input.int(5, "Line Extension Bars", minval = 1, maxval = 20, group = grpCISD)
styleOption       = input.string("Solid (─)", "Line Style", options = ["Solid (─)", "Dotted (┈)", "Dashed (╌)"], group = grpCISD)
keepLevels        = input.bool(false, "Keep old CISD levels", group = grpCISD)

grpStruct = "Strukturbrüche (BOS / CHoCH)"
showStructureBreaks = input.bool(true, "CHoCH Marker auf Chart anzeigen", group = grpStruct)
pivLeft  = input.int(5, "Pivot Left Bars", minval = 2, group = grpStruct)
pivRight = input.int(2, "Pivot Right Bars", minval = 1, group = grpStruct)

grpMTF = "Multi-Timeframe Lieferstatus"
tfPreset = input.string("Daytrade (D / 1H / 5m)", "Preset",
     options = ["Custom", "Daytrade (D / 1H / 5m)", "Swing (1W / 4H / 15m)", "Scalp (4H / 15m / 1m)"], group = grpMTF)
htfCustom = input.timeframe("D", "HTF (Custom)", group = grpMTF)
mtfCustom = input.timeframe("60", "MTF (Custom)", group = grpMTF)
ltfCustom = input.timeframe("5", "LTF (Custom)", group = grpMTF)
useConfirmed = input.bool(false, "Nur bestätigte HTF/MTF/LTF-Bars (kein Repaint, 1 Bar Delay)", group = grpMTF)

grpTable = "Tabelle"
showTable     = input.bool(true, "Tabelle anzeigen", group = grpTable)
tablePosition = input.string("Top Right", "Position",
     options = ["Top Right", "Bottom Right", "Middle Right", "Bottom Center", "Middle Left"], group = grpTable)
tableSizeOpt  = input.string("Small", "Schriftgröße", options = ["Tiny", "Small", "Normal", "Large"], group = grpTable)

grpAlert = "Flow Alerts"
alertOnFlowChange = input.bool(false, "Alert bei Wechsel zu Longflow / Shortflow", group = grpAlert)
alertOnLTFFlip    = input.bool(false, "Alert wenn LTF in Richtung von HTF+MTF dreht (Pullback Ende)", group = grpAlert)

grpRisk = "Risiko & Positionsgröße"
accountSize  = input.float(10000, "Kontogröße ($)", minval = 100, step = 500, group = grpRisk)
riskPct      = input.float(1.0, "Risiko pro Trade (%)", minval = 0.1, maxval = 10, step = 0.25, group = grpRisk)
maxContracts = input.int(20, "Max. Kontrakte (Cap)", minval = 1, group = grpRisk)
pvOverride = input.string("Chart-Symbol (auto)", "Trading-Instrument (Punktwert)", options = [
     "Chart-Symbol (auto)",
     "MNQ ($2)", "NQ ($20)",
     "MES ($5)", "ES ($50)",
     "MYM ($0.50)", "YM ($5)",
     "M2K ($5)", "RTY ($50)",
     "MGC ($10)", "GC ($100)",
     "MCL ($100)", "CL ($1000)",
     "Custom"], group = grpRisk, tooltip = "Wenn du z.B. den NQ-Chart anschaust aber MNQ handelst, hier MNQ wählen - die Kontraktberechnung nutzt dann dessen Punktwert statt syminfo.pointvalue.")
pvCustom = input.float(2.0, "Custom Punktwert ($/Punkt)", minval = 0.01, step = 0.5, group = grpRisk)
atrLen       = input.int(14, "ATR Länge", minval = 1, group = grpRisk)
adxLen       = input.int(14, "ADX Länge", minval = 1, group = grpRisk)
adxTrendTh   = input.float(25, "ADX Trend-Schwelle", minval = 5, group = grpRisk, tooltip = "ADX darüber = Trendmarkt: weiterer Stop, höheres R-Ziel.")
adxChopTh    = input.float(18, "ADX Chop-Schwelle", minval = 1, group = grpRisk, tooltip = "ADX darunter = Seitwärtsmarkt: Vorsicht, reduziertes Ziel.")
slMultBase   = input.float(1.5, "SL = ATR ×", minval = 0.3, step = 0.1, group = grpRisk)
rrChop       = input.float(1.5, "TP (R) im Chop", minval = 0.5, step = 0.25, group = grpRisk)
rrTrend      = input.float(3.0, "TP (R) im Trend", minval = 0.5, step = 0.25, group = grpRisk)
showTradeLevels = input.bool(true, "Entry/SL/TP Linien bei LTF-Flip zeichnen", group = grpRisk)

grpQT = "Quarter Theory"
showQT = input.bool(true, "Quarter-Spalte im Dashboard", group = grpQT)

grpVP = "Quarter Volumenprofil"
showVP      = input.bool(true, "POC/VAH/VAL des aktuellen Quarters", group = grpVP)
vpCycle     = input.string("6H", "Profil-Zyklus", options = ["90m", "6H", "Daily", "Weekly"], group = grpVP)
vpValueArea = input.float(70, "Value Area %", minval = 50, maxval = 95, group = grpVP)
vpPocColor  = input.color(color.new(color.orange, 0), "POC", inline = "vpc", group = grpVP)
vpVaColor   = input.color(color.new(color.gray, 40), "VAH/VAL", inline = "vpc", group = grpVP)

// ============================================================================
// HELPERS
// ============================================================================

lineStyle = styleOption == "Dotted (┈)" ? line.style_dotted : styleOption == "Dashed (╌)" ? line.style_dashed : line.style_solid

f_tablePos(pos) =>
    switch pos
        "Top Right"     => position.top_right
        "Bottom Right"  => position.bottom_right
        "Middle Right"  => position.middle_right
        "Bottom Center" => position.bottom_center
        "Middle Left"   => position.middle_left
        => position.top_right

tSize = switch tableSizeOpt
    "Tiny"  => size.tiny
    "Small" => size.small
    "Large" => size.large
    => size.normal

[htf, mtf, ltf] = switch tfPreset
    "Daytrade (D / 1H / 5m)"   => ["D", "60", "5"]
    "Swing (1W / 4H / 15m)"    => ["W", "240", "15"]
    "Scalp (4H / 15m / 1m)"    => ["240", "15", "1"]
    => [htfCustom, mtfCustom, ltfCustom]

// ============================================================================
// CISD STATE ENGINE (no drawing -> safe for request.security)
// Returns the most recently CONFIRMED delivery state:
//   1  = Bullish CISD confirmed (long delivery)
//  -1  = Bearish CISD confirmed (short delivery)
//   0  = not yet determined
// ============================================================================
f_cisdState() =>
    var float structTop    = high
    var float structBottom = low

    var bool isBullishPullback = false
    var bool isBearishPullback = false

    var float potentialTop    = na
    var float potentialBottom = na

    var int bullBreakIdx = na
    var int bearBreakIdx = na

    var float plusLevel  = na   // pending "+CISD" level (confirms Bullish)
    var float minusLevel = na   // pending "-CISD" level (confirms Bearish)
    var bool  plusActive  = false
    var bool  minusActive = false

    var int state = 0

    bearishPB = close[1] > open[1]
    bullishPB = close[1] < open[1]

    if bearishPB and not isBearishPullback
        isBearishPullback := true
        potentialTop := open[1]
        bullBreakIdx := bar_index[1]

    if bullishPB and not isBullishPullback
        isBullishPullback := true
        potentialBottom := open[1]
        bearBreakIdx := bar_index[1]

    if isBullishPullback
        if open < potentialBottom
            potentialBottom := open
            bearBreakIdx := bar_index
        if close < open and open > potentialBottom
            potentialBottom := open
            bearBreakIdx := bar_index

    if isBearishPullback
        if open > potentialTop
            potentialTop := open
            bullBreakIdx := bar_index
        if close > open and open < potentialTop
            potentialTop := open
            bullBreakIdx := bar_index

    // Bearish structure break -> arms a "+CISD" (bullish reversal) level
    if low < structBottom
        structBottom := low
        if isBearishPullback and (bar_index - bullBreakIdx != 0)
            structTop := math.max(high[bar_index - bullBreakIdx], high[bar_index - bullBreakIdx + 1])
            isBearishPullback := false
            plusLevel := potentialTop
            plusActive := true
        else if close[1] > open[1] and close < open
            structTop := high[1]
            isBearishPullback := false
            plusLevel := potentialTop
            plusActive := true

    // Bullish structure break -> arms a "-CISD" (bearish reversal) level
    if high > structTop
        structTop := high
        if isBullishPullback and (bar_index - bearBreakIdx != 0)
            structBottom := math.min(low[bar_index - bearBreakIdx], low[bar_index - bearBreakIdx + 1])
            isBullishPullback := false
            minusLevel := potentialBottom
            minusActive := true
        else if close[1] < open[1] and close > open
            structBottom := low[1]
            isBullishPullback := false
            minusLevel := potentialBottom
            minusActive := true

    if plusActive and close > plusLevel
        state := 1
        plusActive := false

    if minusActive and close < minusLevel
        state := -1
        minusActive := false

    state

// ============================================================================
// STRUCTURE ENGINE (BOS / CHoCH via fractal pivots)
// BOS   = Strukturbruch IN Trendrichtung (HH im Aufwärtstrend, LL im Abwärtstrend)
// CHoCH = erster Strukturbruch GEGEN den Trend (Trendwechsel)
// Returns: trend (1 bullish, -1 bearish, 0 undefined),
//          chochUp/chochDown, bosUp/bosDown, pivotPrice
// ============================================================================
f_structure(lbLen, rbLen) =>
    var int trend = 0
    var float lastPH = na
    var float lastPL = na
    bool chochUp = false
    bool chochDown = false
    bool bosUp = false
    bool bosDown = false
    float pivotPrice = na

    ph = ta.pivothigh(lbLen, rbLen)
    pl = ta.pivotlow(lbLen, rbLen)

    if not na(ph)
        if not na(lastPH) and ph > lastPH
            if trend == -1
                chochUp := true
            else if trend == 1
                bosUp := true
            trend := 1
        else if not na(lastPH) and ph <= lastPH and trend == 1
            chochDown := true
            trend := -1
        lastPH := ph
        pivotPrice := ph

    if not na(pl)
        if not na(lastPL) and pl < lastPL
            if trend == 1
                chochDown := true
            else if trend == -1
                bosDown := true
            trend := -1
        else if not na(lastPL) and pl >= lastPL and trend == -1
            chochUp := true
            trend := 1
        lastPL := pl
        pivotPrice := pl

    [trend, chochUp, chochDown, bosUp, bosDown, pivotPrice]

// ============================================================================
// MULTI-TIMEFRAME DATA
// ============================================================================

htfCISD_raw = request.security(syminfo.tickerid, htf, f_cisdState(), lookahead = barmerge.lookahead_off)
mtfCISD_raw = request.security(syminfo.tickerid, mtf, f_cisdState(), lookahead = barmerge.lookahead_off)
ltfCISD_raw = request.security(syminfo.tickerid, ltf, f_cisdState(), lookahead = barmerge.lookahead_off)

htfCISD = useConfirmed ? htfCISD_raw[1] : htfCISD_raw
mtfCISD = useConfirmed ? mtfCISD_raw[1] : mtfCISD_raw
ltfCISD = useConfirmed ? ltfCISD_raw[1] : ltfCISD_raw

[htfTrend_raw, htfChU_raw, htfChD_raw, htfBU_raw, htfBD_raw, _htfPP] = request.security(syminfo.tickerid, htf, f_structure(pivLeft, pivRight), lookahead = barmerge.lookahead_off)
[mtfTrend_raw, mtfChU_raw, mtfChD_raw, mtfBU_raw, mtfBD_raw, _mtfPP] = request.security(syminfo.tickerid, mtf, f_structure(pivLeft, pivRight), lookahead = barmerge.lookahead_off)
[ltfTrend_raw, ltfChU_raw, ltfChD_raw, ltfBU_raw, ltfBD_raw, _ltfPP] = request.security(syminfo.tickerid, ltf, f_structure(pivLeft, pivRight), lookahead = barmerge.lookahead_off)

htfTrend = useConfirmed ? htfTrend_raw[1] : htfTrend_raw
mtfTrend = useConfirmed ? mtfTrend_raw[1] : mtfTrend_raw
ltfTrend = useConfirmed ? ltfTrend_raw[1] : ltfTrend_raw

htfChU = useConfirmed ? htfChU_raw[1] : htfChU_raw
htfChD = useConfirmed ? htfChD_raw[1] : htfChD_raw
mtfChU = useConfirmed ? mtfChU_raw[1] : mtfChU_raw
mtfChD = useConfirmed ? mtfChD_raw[1] : mtfChD_raw
ltfChU = useConfirmed ? ltfChU_raw[1] : ltfChU_raw
ltfChD = useConfirmed ? ltfChD_raw[1] : ltfChD_raw

htfBU = useConfirmed ? htfBU_raw[1] : htfBU_raw
htfBD = useConfirmed ? htfBD_raw[1] : htfBD_raw
mtfBU = useConfirmed ? mtfBU_raw[1] : mtfBU_raw
mtfBD = useConfirmed ? mtfBD_raw[1] : mtfBD_raw
ltfBU = useConfirmed ? ltfBU_raw[1] : ltfBU_raw
ltfBD = useConfirmed ? ltfBD_raw[1] : ltfBD_raw

// ============================================================================
// FLOW LOGIC
// ============================================================================

allBull   = htfCISD == 1  and mtfCISD == 1  and ltfCISD == 1
allBear   = htfCISD == -1 and mtfCISD == -1 and ltfCISD == -1
htfMtfBull = htfCISD == 1  and mtfCISD == 1
htfMtfBear = htfCISD == -1 and mtfCISD == -1

flowText = allBull ? "LONGFLOW" : allBear ? "SHORTFLOW" : "MIXED"
flowColor = allBull ? color.new(color.green, 0) : allBear ? color.new(color.red, 0) : color.new(color.gray, 50)

flowDetail = allBull ? "Alle TFs bullish" :
     allBear ? "Alle TFs bearish" :
     htfMtfBull and ltfCISD == -1 ? "Pullback (Long Bias)" :
     htfMtfBear and ltfCISD == 1 ? "Pullback (Short Bias)" :
     "Uneinheitlich"

// ============================================================================
// CHART-TF: CISD DRAWING (lines / labels)
// ============================================================================

var float c_structTop    = high
var float c_structBottom = low

var bool c_isBullishPullback = false
var bool c_isBearishPullback = false

var float c_potentialTop    = na
var float c_potentialBottom = na

var int c_bullBreakIdx = na
var int c_bearBreakIdx = na

var line  plusLine   = na
var label plusLabel  = na
var line  minusLine  = na
var label minusLabel = na
var bool  plusActiveC  = false
var bool  minusActiveC = false

c_bearishPB = close[1] > open[1]
c_bullishPB = close[1] < open[1]

if c_bearishPB and not c_isBearishPullback
    c_isBearishPullback := true
    c_potentialTop := open[1]
    c_bullBreakIdx := bar_index[1]

if c_bullishPB and not c_isBullishPullback
    c_isBullishPullback := true
    c_potentialBottom := open[1]
    c_bearBreakIdx := bar_index[1]

if c_isBullishPullback
    if open < c_potentialBottom
        c_potentialBottom := open
        c_bearBreakIdx := bar_index
    if close < open and open > c_potentialBottom
        c_potentialBottom := open
        c_bearBreakIdx := bar_index

if c_isBearishPullback
    if open > c_potentialTop
        c_potentialTop := open
        c_bullBreakIdx := bar_index
    if close > open and open < c_potentialTop
        c_potentialTop := open
        c_bullBreakIdx := bar_index

if low < c_structBottom
    c_structBottom := low
    if c_isBearishPullback and (bar_index - c_bullBreakIdx != 0)
        c_structTop := math.max(high[bar_index - c_bullBreakIdx], high[bar_index - c_bullBreakIdx + 1])
        c_isBearishPullback := false
        if not keepLevels and not na(plusLine)
            line.delete(plusLine)
            label.delete(plusLabel)
        plusLine := line.new(c_bullBreakIdx, c_potentialTop, bar_index + lookAheadBars, c_potentialTop, color = bullishBreakColor, width = lineWidth, style = lineStyle)
        plusLabel := label.new(bar_index + lookAheadBars, c_potentialTop, bullStr, color = color.new(color.white, 100), textcolor = bullishBreakColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
        plusActiveC := true
    else if close[1] > open[1] and close < open
        c_structTop := high[1]
        c_isBearishPullback := false
        if not keepLevels and not na(plusLine)
            line.delete(plusLine)
            label.delete(plusLabel)
        plusLine := line.new(c_bullBreakIdx, c_potentialTop, bar_index + lookAheadBars, c_potentialTop, color = bullishBreakColor, width = lineWidth, style = lineStyle)
        plusLabel := label.new(bar_index + lookAheadBars, c_potentialTop, bullStr, color = color.new(color.white, 100), textcolor = bullishBreakColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
        plusActiveC := true

if high > c_structTop
    c_structTop := high
    if c_isBullishPullback and (bar_index - c_bearBreakIdx != 0)
        c_structBottom := math.min(low[bar_index - c_bearBreakIdx], low[bar_index - c_bearBreakIdx + 1])
        c_isBullishPullback := false
        if not keepLevels and not na(minusLine)
            line.delete(minusLine)
            label.delete(minusLabel)
        minusLine := line.new(c_bearBreakIdx, c_potentialBottom, bar_index + lookAheadBars, c_potentialBottom, color = bearishBreakColor, width = lineWidth, style = lineStyle)
        minusLabel := label.new(bar_index + lookAheadBars, c_potentialBottom, bearStr, color = color.new(color.white, 100), textcolor = bearishBreakColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
        minusActiveC := true
    else if close[1] < open[1] and close > open
        c_structBottom := low[1]
        c_isBullishPullback := false
        if not keepLevels and not na(minusLine)
            line.delete(minusLine)
            label.delete(minusLabel)
        minusLine := line.new(c_bearBreakIdx, c_potentialBottom, bar_index + lookAheadBars, c_potentialBottom, color = bearishBreakColor, width = lineWidth, style = lineStyle)
        minusLabel := label.new(bar_index + lookAheadBars, c_potentialBottom, bearStr, color = color.new(color.white, 100), textcolor = bearishBreakColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
        minusActiveC := true

if plusActiveC
    line.set_x2(plusLine, bar_index + lookAheadBars)
    label.set_x(plusLabel, bar_index + lookAheadBars)
    if close > line.get_y2(plusLine)
        plusActiveC := false
        if bullishAlerts
            alert("Bullish CISD confirmed (" + syminfo.ticker + ", " + timeframe.period + ")", alert.freq_once_per_bar_close)

if minusActiveC
    line.set_x2(minusLine, bar_index + lookAheadBars)
    label.set_x(minusLabel, bar_index + lookAheadBars)
    if close < line.get_y2(minusLine)
        minusActiveC := false
        if bearishAlerts
            alert("Bearish CISD confirmed (" + syminfo.ticker + ", " + timeframe.period + ")", alert.freq_once_per_bar_close)

// ============================================================================
// CHART-TF: CHoCH MARKERS
// ============================================================================

[_chartTrend, chochUp, chochDown, bosUp, bosDown, pivotPrice] = f_structure(pivLeft, pivRight)

if showStructureBreaks and chochUp
    label.new(bar_index - pivRight, pivotPrice, "CHoCH▲", style = label.style_label_up, color = color.new(color.white, 100), textcolor = color.lime, size = size.tiny, text_formatting = text.format_bold)

if showStructureBreaks and chochDown
    label.new(bar_index - pivRight, pivotPrice, "CHoCH▼", style = label.style_label_down, color = color.new(color.white, 100), textcolor = color.red, size = size.tiny, text_formatting = text.format_bold)

if showStructureBreaks and bosUp
    label.new(bar_index - pivRight, pivotPrice, "BOS▲", style = label.style_label_up, color = color.new(color.white, 100), textcolor = color.new(color.lime, 40), size = size.tiny)

if showStructureBreaks and bosDown
    label.new(bar_index - pivRight, pivotPrice, "BOS▼", style = label.style_label_down, color = color.new(color.white, 100), textcolor = color.new(color.red, 40), size = size.tiny)

// ============================================================================
// FLOW ALERTS
// ============================================================================

var int prevFlow = 0
curFlow = allBull ? 1 : allBear ? -1 : 0

if alertOnFlowChange and curFlow != prevFlow and curFlow != 0
    alert("Flow-Wechsel: " + (curFlow == 1 ? "LONGFLOW" : "SHORTFLOW") + " (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
prevFlow := curFlow

ltfFlipToLong  = htfCISD == 1  and mtfCISD == 1  and ltfCISD == 1  and ltfCISD[1] != 1
ltfFlipToShort = htfCISD == -1 and mtfCISD == -1 and ltfCISD == -1 and ltfCISD[1] != -1

if alertOnLTFFlip and (ltfFlipToLong or ltfFlipToShort)
    alert("LTF CISD Flip in Trendrichtung (" + (ltfFlipToLong ? "Long" : "Short") + ") - " + syminfo.ticker, alert.freq_once_per_bar_close)

// ============================================================================
// RISK MODULE: ATR/ADX-adaptive SL/TP + position sizing
// ============================================================================

atrVal = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

// 0 = Chop, 1 = Trend, smooth interpolation in between
trendFactor = math.min(math.max((adxVal - adxChopTh) / math.max(adxTrendTh - adxChopTh, 0.1), 0.0), 1.0)
regimeText  = adxVal >= adxTrendTh ? "Trend" : adxVal <= adxChopTh ? "Chop" : "Neutral"

// Stop slightly wider in trend regime (price breathes more), TP scales from rrChop to rrTrend
slMult  = slMultBase * (1.0 + 0.3 * trendFactor)
rrRatio = rrChop + (rrTrend - rrChop) * trendFactor

stopDist = atrVal * slMult
tpDist   = stopDist * rrRatio

// Position sizing: risk budget / (stop distance in points * $ per point)
riskMoney  = accountSize * riskPct / 100.0
pointValue = switch pvOverride
    "MNQ ($2)"     => 2.0
    "NQ ($20)"     => 20.0
    "MES ($5)"     => 5.0
    "ES ($50)"     => 50.0
    "MYM ($0.50)"  => 0.5
    "YM ($5)"      => 5.0
    "M2K ($5)"     => 5.0
    "RTY ($50)"    => 50.0
    "MGC ($10)"    => 10.0
    "GC ($100)"    => 100.0
    "MCL ($100)"   => 100.0
    "CL ($1000)"   => 1000.0
    "Custom"       => pvCustom
    => syminfo.pointvalue
rawContracts = stopDist > 0 and pointValue > 0 ? math.floor(riskMoney / (stopDist * pointValue)) : 0
contracts    = math.min(rawContracts, maxContracts)
riskActual   = contracts * stopDist * pointValue

// Draw Entry/SL/TP when LTF flips into full flow
var line  entryLine = na
var line  slLine    = na
var line  tpLine    = na
var label entryLbl  = na
var label slLbl     = na
var label tpLbl     = na

if showTradeLevels and (ltfFlipToLong or ltfFlipToShort)
    dirSign  = ltfFlipToLong ? 1 : -1
    entryPx  = close
    slPx     = entryPx - dirSign * stopDist
    tpPx     = entryPx + dirSign * tpDist
    line.delete(entryLine), label.delete(entryLbl)
    line.delete(slLine),    label.delete(slLbl)
    line.delete(tpLine),    label.delete(tpLbl)
    entryLine := line.new(bar_index, entryPx, bar_index + lookAheadBars, entryPx, color = color.new(color.blue, 0), width = lineWidth, style = line.style_solid)
    slLine    := line.new(bar_index, slPx, bar_index + lookAheadBars, slPx, color = color.new(color.red, 0), width = lineWidth, style = line.style_dashed)
    tpLine    := line.new(bar_index, tpPx, bar_index + lookAheadBars, tpPx, color = color.new(color.green, 0), width = lineWidth, style = line.style_dashed)
    entryLbl  := label.new(bar_index + lookAheadBars, entryPx, "Entry " + str.tostring(entryPx, format.mintick) + " | " + str.tostring(contracts) + "x", style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.blue, size = size.small)
    slLbl     := label.new(bar_index + lookAheadBars, slPx, "SL " + str.tostring(slPx, format.mintick) + " (" + str.tostring(slMult, "#.#") + "×ATR)", style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.red, size = size.small)
    tpLbl     := label.new(bar_index + lookAheadBars, tpPx, "TP " + str.tostring(tpPx, format.mintick) + " (" + str.tostring(rrRatio, "#.#") + "R)", style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.green, size = size.small)

if not na(entryLine)
    line.set_x2(entryLine, bar_index + lookAheadBars), label.set_x(entryLbl, bar_index + lookAheadBars)
    line.set_x2(slLine, bar_index + lookAheadBars),    label.set_x(slLbl, bar_index + lookAheadBars)
    line.set_x2(tpLine, bar_index + lookAheadBars),    label.set_x(tpLbl, bar_index + lookAheadBars)

// ============================================================================
// QUARTER THEORY: deterministic NY-time quarter slots
// 90m: anchored 19:00 NY (Q1-Q4 per session) | 6H: anchored 18:00 NY
// Daily: Sun-Wed = Q1-Q4 (CME week)          | Weekly: week of month
// ============================================================================

const string TZ = "America/New_York"

t1900  = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), 19, 0)
base90 = time >= t1900 ? t1900 : timestamp(TZ, year(time - 86400000, TZ), month(time - 86400000, TZ), dayofmonth(time - 86400000, TZ), 19, 0)
slot90 = int(math.floor((time - base90) / 5400000))
q90    = slot90 >= 0 and slot90 < 16 ? slot90 % 4 + 1 : 0
key90  = base90 + slot90 * 5400000

t1800 = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), 18, 0)
base6 = time >= t1800 ? t1800 : timestamp(TZ, year(time - 86400000, TZ), month(time - 86400000, TZ), dayofmonth(time - 86400000, TZ), 18, 0)
slot6 = math.max(0, math.min(int(math.floor((time - base6) / 21600000)), 3))
q6    = slot6 + 1
key6  = base6 + slot6 * 21600000

dowNY = dayofweek(time, TZ)
qD = dowNY == dayofweek.sunday ? 1 : dowNY == dayofweek.monday ? 2 : dowNY == dayofweek.tuesday ? 3 : dowNY == dayofweek.wednesday ? 4 : 0
nyDayKey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)

qW = math.min(int(math.floor((dayofmonth(time, TZ) - 1) / 7)) + 1, 4)
keyW = year(time, TZ) * 1000 + month(time, TZ) * 10 + qW

f_qTxt(int q) => q > 0 ? "Q" + str.tostring(q) : "–"

// ============================================================================
// QUARTER VOLUME PROFILE: POC / VAH / VAL of the current quarter
// 1m volume is bucketed into price bins (bin size fixed at quarter start),
// POC = max-volume bin, VA expands from POC until vpValueArea% is covered.
// ============================================================================

[vpCloses, vpVolumes] = request.security_lower_tf(syminfo.tickerid, "1", [close, volume])

int vpKey = vpCycle == "90m" ? key90 : vpCycle == "6H" ? key6 : vpCycle == "Daily" ? nyDayKey : keyW

var float[] vpVols  = array.new_float()
var int   vpBase    = na
var float vpStep    = na
var int   vpStartT  = na
var int   vpLastKey = na

var line  pocLine = na
var line  vahLine = na
var line  valLine = na
var label pocLbl  = na

if showVP
    if na(vpLastKey) or vpKey != vpLastKey
        vpLastKey := vpKey
        array.clear(vpVols)
        vpBase   := na
        vpStep   := math.max(nz(atrVal, syminfo.mintick * 10) / 4.0, syminfo.mintick)
        vpStartT := time

    int nSub = array.size(vpCloses)
    if nSub > 0 and not na(vpStep)
        for i = 0 to nSub - 1
            float c = array.get(vpCloses, i)
            float v = nz(array.get(vpVolumes, i))
            int idx = int(math.round(c / vpStep))
            if na(vpBase)
                vpBase := idx
                array.push(vpVols, v)
            else
                while idx < vpBase and array.size(vpVols) < 4000
                    array.unshift(vpVols, 0.0)
                    vpBase := vpBase - 1
                while idx > vpBase + array.size(vpVols) - 1 and array.size(vpVols) < 4000
                    array.push(vpVols, 0.0)
                int off = idx - vpBase
                if off >= 0 and off < array.size(vpVols)
                    array.set(vpVols, off, array.get(vpVols, off) + v)

    int sz = array.size(vpVols)
    if sz > 0
        int pocOff = 0
        float pocV = -1.0
        float totV = 0.0
        for i = 0 to sz - 1
            float v = array.get(vpVols, i)
            totV += v
            if v > pocV
                pocV := v
                pocOff := i
        float vaTarget = totV * vpValueArea / 100.0
        float vaAcc = pocV
        int lo = pocOff
        int hi = pocOff
        while vaAcc < vaTarget and (lo > 0 or hi < sz - 1)
            float vLo = lo > 0 ? array.get(vpVols, lo - 1) : -1.0
            float vHi = hi < sz - 1 ? array.get(vpVols, hi + 1) : -1.0
            if vHi >= vLo
                hi += 1
                vaAcc += math.max(vHi, 0.0)
            else
                lo -= 1
                vaAcc += math.max(vLo, 0.0)
        float pocPx = (vpBase + pocOff) * vpStep
        float vahPx = (vpBase + hi) * vpStep
        float valPx = (vpBase + lo) * vpStep

        if na(pocLine)
            pocLine := line.new(vpStartT, pocPx, time, pocPx, xloc = xloc.bar_time, color = vpPocColor, width = 2)
            vahLine := line.new(vpStartT, vahPx, time, vahPx, xloc = xloc.bar_time, color = vpVaColor, style = line.style_dotted)
            valLine := line.new(vpStartT, valPx, time, valPx, xloc = xloc.bar_time, color = vpVaColor, style = line.style_dotted)
            pocLbl  := label.new(time, pocPx, "POC " + vpCycle, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = vpPocColor, size = size.tiny)
        else
            line.set_xy1(pocLine, vpStartT, pocPx), line.set_xy2(pocLine, time, pocPx)
            line.set_xy1(vahLine, vpStartT, vahPx), line.set_xy2(vahLine, time, vahPx)
            line.set_xy1(valLine, vpStartT, valPx), line.set_xy2(valLine, time, valPx)
            label.set_xy(pocLbl, time, pocPx)
else if not na(pocLine)
    line.delete(pocLine), line.delete(vahLine), line.delete(valLine), label.delete(pocLbl)
    pocLine := na

// ============================================================================
// DASHBOARD (compact)
// ============================================================================

f_glyph(int s) => s == 1 ? "▲" : s == -1 ? "▼" : "·"
f_glyphCol(int s) => s == 1 ? color.new(color.lime, 0) : s == -1 ? color.new(color.red, 0) : color.new(color.gray, 30)

f_structTxt(int trend, bool chU, bool chD, bool bU, bool bD) =>
    g = trend == 1 ? "▲" : trend == -1 ? "▼" : "·"
    chU or chD ? g + " CHoCH" : bU or bD ? g + " BOS" : g

mutedCol = color.new(chart.fg_color, 45)

if showTable and barstate.islast
    var table tbl = table.new(f_tablePos(tablePosition), 4, 8, bgcolor = color.new(chart.bg_color, 15), frame_color = color.new(chart.fg_color, 60), frame_width = 1, border_width = 0)
    var bool tblMerged = false
    if not tblMerged
        table.merge_cells(tbl, 0, 0, 3, 0)
        table.merge_cells(tbl, 0, 5, 3, 5)
        table.merge_cells(tbl, 0, 6, 3, 6)
        table.merge_cells(tbl, 0, 7, 3, 7)
        tblMerged := true

    // Header: ticker + flow as one colored strip
    table.cell(tbl, 0, 0, syminfo.ticker + "   " + flowText, text_color = color.white, bgcolor = flowColor, text_size = tSize, text_formatting = text.format_bold)

    // Column headers
    table.cell(tbl, 0, 1, "TF", text_color = mutedCol, text_size = size.tiny)
    table.cell(tbl, 1, 1, "CISD", text_color = mutedCol, text_size = size.tiny)
    table.cell(tbl, 2, 1, "Strukt", text_color = mutedCol, text_size = size.tiny)
    if showQT
        table.cell(tbl, 3, 1, "Q", text_color = mutedCol, text_size = size.tiny)

    // TF rows: HTF -> Weekly Q, MTF -> Daily Q, LTF -> 6H Q
    table.cell(tbl, 0, 2, htf, text_color = chart.fg_color, text_size = tSize)
    table.cell(tbl, 1, 2, f_glyph(htfCISD), text_color = f_glyphCol(htfCISD), text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 2, 2, f_structTxt(htfTrend, htfChU, htfChD, htfBU, htfBD), text_color = f_glyphCol(htfTrend), text_size = tSize)
    if showQT
        table.cell(tbl, 3, 2, "W " + f_qTxt(qW), text_color = mutedCol, text_size = tSize)

    table.cell(tbl, 0, 3, mtf, text_color = chart.fg_color, text_size = tSize)
    table.cell(tbl, 1, 3, f_glyph(mtfCISD), text_color = f_glyphCol(mtfCISD), text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 2, 3, f_structTxt(mtfTrend, mtfChU, mtfChD, mtfBU, mtfBD), text_color = f_glyphCol(mtfTrend), text_size = tSize)
    if showQT
        table.cell(tbl, 3, 3, "D " + f_qTxt(qD), text_color = mutedCol, text_size = tSize)

    table.cell(tbl, 0, 4, ltf, text_color = chart.fg_color, text_size = tSize)
    table.cell(tbl, 1, 4, f_glyph(ltfCISD), text_color = f_glyphCol(ltfCISD), text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 2, 4, f_structTxt(ltfTrend, ltfChU, ltfChD, ltfBU, ltfBD), text_color = f_glyphCol(ltfTrend), text_size = tSize)
    if showQT
        table.cell(tbl, 3, 4, "6H " + f_qTxt(q6), text_color = mutedCol, text_size = tSize)

    // Market regime strip
    regimeCol = regimeText == "Trend" ? color.new(color.lime, 0) : regimeText == "Chop" ? color.new(color.orange, 0) : mutedCol
    table.cell(tbl, 0, 5, "ATR " + str.tostring(atrVal, format.mintick) + "  ·  ADX " + str.tostring(adxVal, "#.#") + " " + regimeText, text_color = regimeCol, text_size = size.tiny)

    // SL/TP + contracts strip
    sizeCol = contracts <= 0 ? color.new(color.red, 0) : regimeText == "Chop" ? color.new(color.orange, 0) : color.new(color.lime, 0)
    sizeTxt = contracts <= 0 ? "0x – Stop zu groß!" : str.tostring(contracts) + "x" + (rawContracts > maxContracts ? " (Cap)" : "")
    table.cell(tbl, 0, 6, "SL " + str.tostring(stopDist, format.mintick) + "  ·  TP " + str.tostring(tpDist, format.mintick) + " (" + str.tostring(rrRatio, "#.#") + "R)  ·  " + sizeTxt, text_color = sizeCol, text_size = size.tiny)

    // Account strip
    table.cell(tbl, 0, 7, "$" + str.tostring(accountSize, "#,###") + "  ·  " + str.tostring(riskPct, "#.##") + "% = $" + str.tostring(riskMoney, "#,###") + "  ·  $" + str.tostring(pointValue, "#.##") + "/Pkt", text_color = mutedCol, text_size = size.tiny)
