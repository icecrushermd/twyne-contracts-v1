//@version=6
indicator("CISD Multi-Timeframe Flow [neo|]", "CISD Flow", overlay = true, max_lines_count = 200, max_labels_count = 200, dynamic_requests = true)

// ============================================================================
// INPUTS
// ============================================================================

grpCISD = "CISD Darstellung (Chart-TF)"
bullishBreakColor = input.color(color.new(color.lime, 0), "Bull CISD", inline = "bup", group = grpCISD)
bearishBreakColor = input.color(color.new(color.red, 0), "Bear CISD", inline = "bep", group = grpCISD)
bullStr           = input.string("+CISD", "Text", inline = "bup", group = grpCISD)
bearStr           = input.string("-CISD", "Text", inline = "bep", group = grpCISD)
bullishAlerts     = input.bool(false, "Alert?", inline = "bup", group = grpCISD, tooltip = "Alert wenn der Kurs über das aktuelle '+CISD' Level schließt.")
bearishAlerts     = input.bool(false, "Alert?", inline = "bep", group = grpCISD, tooltip = "Alert wenn der Kurs unter das aktuelle '-CISD' Level schließt.")
lineWidth         = input.int(1, "Line Width", minval = 1, maxval = 5, group = grpCISD)
lookAheadBars     = input.int(5, "Line Extension Bars", minval = 1, maxval = 20, group = grpCISD)
styleOption       = input.string("Solid (─)", "Line Style", options = ["Solid (─)", "Dotted (┈)", "Dashed (╌)"], group = grpCISD)
keepLevels        = input.bool(false, "Keep old CISD levels", group = grpCISD)

grpStruct = "Strukturbrüche (BOS / CHoCH)"
showStructureBreaks = input.bool(true, "CHoCH Marker auf Chart anzeigen", group = grpStruct)
pivLeft  = input.int(5, "Pivot Left Bars", minval = 2, group = grpStruct)
pivRight = input.int(2, "Pivot Right Bars", minval = 1, group = grpStruct)

grpMTF = "Multi-Timeframe Lieferstatus"
tfPreset = input.string("Daytrade (D / 1H / 5m)", "Preset",
     options = ["Custom", "Daytrade (D / 1H / 5m)", "Swing (1W / 4H / 15m)", "Scalp (4H / 15m / 1m)"], group = grpMTF)
htfCustom = input.timeframe("D", "HTF (Custom)", group = grpMTF)
mtfCustom = input.timeframe("60", "MTF (Custom)", group = grpMTF)
ltfCustom = input.timeframe("5", "LTF (Custom)", group = grpMTF)
useConfirmed = input.bool(false, "Nur bestätigte HTF/MTF/LTF-Bars (kein Repaint, 1 Bar Delay)", group = grpMTF)

grpTable = "Tabelle"
showTable     = input.bool(true, "Tabelle anzeigen", group = grpTable)
tablePosition = input.string("Top Right", "Position",
     options = ["Top Right", "Bottom Right", "Middle Right", "Bottom Center", "Middle Left"], group = grpTable)
tableSizeOpt  = input.string("Small", "Schriftgröße", options = ["Tiny", "Small", "Normal", "Large"], group = grpTable)
showStatsRow  = input.bool(true, "Setup-Statistik-Zeile anzeigen", group = grpTable, tooltip = "Zählt alle Setups über die geladene Chart-History: TP-Treffer, SL-Treffer, Winrate und durchschnittliches R - quasi ein eingebauter Backtest deiner aktuellen Einstellungen.")

grpAlert = "Flow Alerts"
alertOnFlowChange = input.bool(false, "Alert bei Wechsel zu Longflow / Shortflow", group = grpAlert)
alertOnLTFFlip    = input.bool(false, "Alert wenn LTF in Richtung von HTF+MTF dreht (Pullback Ende)", group = grpAlert)

grpRisk = "Risiko & Positionsgröße"
accountSize  = input.float(10000, "Kontogröße ($)", minval = 100, step = 500, group = grpRisk)
riskPct      = input.float(1.0, "Risiko pro Trade (%)", minval = 0.1, maxval = 10, step = 0.25, group = grpRisk)
maxContracts = input.int(20, "Max. Kontrakte (Cap)", minval = 1, group = grpRisk)
pvOverride = input.string("Chart-Symbol (auto)", "Trading-Instrument (Punktwert)", options = [
     "Chart-Symbol (auto)",
     "MNQ ($2)", "NQ ($20)",
     "MES ($5)", "ES ($50)",
     "MYM ($0.50)", "YM ($5)",
     "M2K ($5)", "RTY ($50)",
     "MGC ($10)", "GC ($100)",
     "MCL ($100)", "CL ($1000)",
     "Custom"], group = grpRisk, tooltip = "Wenn du z.B. den NQ-Chart anschaust aber MNQ handelst, hier MNQ wählen - die Kontraktberechnung nutzt dann dessen Punktwert statt syminfo.pointvalue.")
pvCustom = input.float(2.0, "Custom Punktwert ($/Punkt)", minval = 0.01, step = 0.5, group = grpRisk)
atrLen       = input.int(14, "ATR Länge", minval = 1, group = grpRisk)
adxLen       = input.int(14, "ADX Länge", minval = 1, group = grpRisk)
adxTrendTh   = input.float(25, "ADX Trend-Schwelle", minval = 5, group = grpRisk, tooltip = "ADX darüber = Trendmarkt: weiterer Stop, höheres R-Ziel.")
adxChopTh    = input.float(18, "ADX Chop-Schwelle", minval = 1, group = grpRisk, tooltip = "ADX darunter = Seitwärtsmarkt: Vorsicht, reduziertes Ziel.")
slMultBase   = input.float(1.5, "SL = ATR ×", minval = 0.3, step = 0.1, group = grpRisk)
rrChop       = input.float(1.5, "TP (R) im Chop", minval = 0.5, step = 0.25, group = grpRisk)
rrTrend      = input.float(3.0, "TP (R) im Trend", minval = 0.5, step = 0.25, group = grpRisk)
showTradeLevels = input.bool(true, "Entry/SL/TP Linien bei LTF-Flip zeichnen", group = grpRisk)
tradeTimeoutBars = input.int(90, "Setup-Timeout (Bars)", minval = 10, group = grpRisk, tooltip = "Nach so vielen Bars ohne SL/TP-Treffer wird das Setup als abgelaufen markiert.")
fvgEntryMode = input.bool(true, "Entry am ersten FVG nach Flip", group = grpRisk, tooltip = "Statt sofort beim LTF-Flip einzusteigen, wird auf das erste Fair Value Gap in Trade-Richtung gewartet - dessen Mitte wird zum Entry, das FVG wird als Entry-Zone eingezeichnet.")
fvgScanBars  = input.int(30, "FVG-Suchfenster (Bars)", minval = 3, group = grpRisk, tooltip = "Erscheint innerhalb dieses Fensters kein FVG in Trade-Richtung, verfällt das Signal.")
beHint    = input.bool(true, "Break-Even-Hinweis bei 1R Gewinn", group = grpRisk, tooltip = "Sobald ein laufendes Setup 1R im Gewinn war, wird die Entry-Linie türkis und das Label mit [BE möglich] markiert - Erinnerung, den Stop auf Einstand zu ziehen.")
showScore = input.bool(true, "Confluence-Score im Entry-Label", group = grpRisk, tooltip = "Bewertet jedes Signal mit 0-7 Punkten: HTF-Flow, MTF-Struktur, CVD, Absorption, Killzone, Quarter Q2/Q3, Entry nahe Volumen-/Gap-Level.")

grpTO = "True Opens & Opening Gaps"
showTDOln  = input.bool(true, "True Day Open (00:00 NY)", inline = "tdo", group = grpTO)
colTDOln   = input.color(color.new(#5252ff, 0), "", inline = "tdo", group = grpTO)
showNYAMln = input.bool(true, "NY AM Open (09:30 NY)", inline = "nyam", group = grpTO)
colNYAMln  = input.color(color.new(#f44336, 0), "", inline = "nyam", group = grpTO)
showGapBoxes = input.bool(true, "NDOG/NWOG Boxen anzeigen", group = grpTO)
gapSnap      = input.bool(true, "NDOG/NWOG als TP-Snap-Kandidaten", group = grpTO, tooltip = "Die Mitte des letzten New Day / New Week Opening Gap wird zusätzlich zu POC/VAH/VAL als TP-Ziel geprüft.")
ndogColIn = input.color(color.new(color.orange, 0), "NDOG", inline = "gc", group = grpTO)
nwogColIn = input.color(color.new(#2196f3, 0), "NWOG", inline = "gc", group = grpTO)

grpOF = "Orderflow / Delta"
deltaSrcIn = input.string("1m Up/Down (alle Pläne)", "Delta-Quelle", options = ["1m Up/Down (alle Pläne)", "Footprint Bid/Ask (Premium/Ultimate)"], group = grpOF, tooltip = "Footprint nutzt echtes Bid/Ask-Volumen pro Preislevel (request.footprint, benötigt TradingView Premium oder Ultimate). Die 1m-Variante klassifiziert 1-Minuten-Kerzen nach Schlussrichtung und funktioniert auf allen Plänen.")
fpTicksRow = input.int(4, "Footprint: Ticks pro Row", minval = 1, group = grpOF)
deltaFilterMode = input.string("Warnen", "Delta-Bestätigung am Entry", options = ["Aus", "Warnen", "Blocken"], group = grpOF, tooltip = "Prüft beim Signal, ob das CVD in Trade-Richtung läuft und keine frische Absorption dagegen steht. 'Warnen' markiert das Entry-Label mit Δ⚠, 'Blocken' unterdrückt das Signal.")
showDeltaRow = input.bool(true, "Delta-Zeile im Dashboard", group = grpOF)
showCvdDiv = input.bool(true, "CVD-Divergenz Marker (◆)", group = grpOF, tooltip = "Markiert Pivot-Hochs/-Tiefs, an denen der Preis ein neues Extrem macht, das Session-CVD aber nicht mitzieht - klassisches Erschöpfungssignal.")
showDeltaCandles = input.bool(true, "Delta pro Kerze (letzte N Bars)", group = grpOF, tooltip = "Zeigt unter jeder Kerze ihr Delta. Dreht das Delta innerhalb der Kerze (erste Hälfte positiv, Schluss negativ oder umgekehrt), wird zusätzlich +→− bzw. −→+ angezeigt.")
deltaLblCount = input.int(12, "Anzahl Delta-Labels", minval = 1, maxval = 50, group = grpOF)
showBigTrades = input.bool(true, "Große Prints markieren", group = grpOF, tooltip = "Markiert die volumenstärkste 1m-Subkerze einer Bar, wenn ihr Volumen ein Vielfaches des durchschnittlichen 1m-Volumens beträgt - Annäherung an einen 'großen Print'.")
bigTradeMult  = input.float(4.0, "Schwelle (× Ø 1m-Volumen)", minval = 1.5, step = 0.5, group = grpOF)

grpTrap = "Trapped Buyers/Sellers"
showTraps = input.bool(true, "Trapped-Marker anzeigen", group = grpTrap, tooltip = "Erkennt Breakouts über/unter ein Pivot mit erhöhtem Volumen, die innerhalb weniger Bars wieder zurückgenommen werden - die Breakout-Trader sitzen 'gefangen' im Verlust.")
trapLookback = input.int(20, "Pivot-Lookback (Bars)", minval = 5, group = grpTrap)
trapConfirmBars = input.int(5, "Reclaim-Fenster (Bars)", minval = 1, maxval = 20, group = grpTrap)
trapVolMult = input.float(1.3, "Breakout-Volumen ≥ × Ø Volumen", minval = 1.0, step = 0.1, group = grpTrap)

grpKZ = "Killzones / Sessions (NY-Zeit)"
kzFilterMode = input.string("Warnen", "Signal-Filter", options = ["Aus", "Warnen", "Blocken"], group = grpKZ, tooltip = "Prüft beim Signal, ob es in einer aktiven Killzone entsteht. 'Warnen' markiert das Entry-Label mit KZ⚠, 'Blocken' unterdrückt Signale außerhalb der Killzones komplett.")
kzLondon = input.bool(true, "London Open (02:00–05:00)", group = grpKZ)
kzNYAM   = input.bool(true, "NY AM (09:30–12:00)", group = grpKZ)
kzNYPM   = input.bool(true, "NY PM (13:30–16:00)", group = grpKZ)

grpQT = "Quarter Theory"
showQT = input.bool(true, "Quarter-Spalte im Dashboard", group = grpQT)

grpVP = "Quarter Volumenprofil"
showVP      = input.bool(true, "POC/VAH/VAL des aktuellen Quarters", group = grpVP)
vpCycle     = input.string("6H", "Profil-Zyklus", options = ["90m", "6H", "Daily", "Weekly"], group = grpVP)
vpValueArea = input.float(70, "Value Area %", minval = 50, maxval = 95, group = grpVP)
vpPocColor  = input.color(color.new(color.orange, 0), "POC", inline = "vpc", group = grpVP)
vpVaColor   = input.color(color.new(color.gray, 40), "VAH/VAL", inline = "vpc", group = grpVP)
tpSnap      = input.bool(true, "TP an POC/VAH/VAL snappen (Confluence)", group = grpVP, tooltip = "Liegt ein Volumen-Level zwischen 0.8x und 1.5x der ATR-Zieldistanz, wird der TP dorthin gelegt statt auf die abstrakte R-Zahl.")
showHVN = input.bool(true, "High-Volume-Nodes (Limit-Linien)", group = grpVP)
hvnThresh = input.float(60, "HVN-Schwelle (% von POC)", minval = 20, maxval = 95, group = grpVP, tooltip = "Preis-Level mit mindestens diesem Anteil des POC-Volumens werden als zusätzliche dünne Linien (mögliche Liquidität/Limit-Orders) eingezeichnet.")

// ============================================================================
// HELPERS
// ============================================================================

const string TZ = "America/New_York"

f_cross(int hh, int mm) =>
    int t = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), hh, mm)
    time >= t and nz(time[1], time - 1) < t

lineStyle = styleOption == "Dotted (┈)" ? line.style_dotted : styleOption == "Dashed (╌)" ? line.style_dashed : line.style_solid

f_tablePos(pos) =>
    switch pos
        "Top Right"     => position.top_right
        "Bottom Right"  => position.bottom_right
        "Middle Right"  => position.middle_right
        "Bottom Center" => position.bottom_center
        "Middle Left"   => position.middle_left
        => position.top_right

tSize = switch tableSizeOpt
    "Tiny"  => size.tiny
    "Small" => size.small
    "Large" => size.large
    => size.normal

[htf, mtf, ltf] = switch tfPreset
    "Daytrade (D / 1H / 5m)"   => ["D", "60", "5"]
    "Swing (1W / 4H / 15m)"    => ["W", "240", "15"]
    "Scalp (4H / 15m / 1m)"    => ["240", "15", "1"]
    => [htfCustom, mtfCustom, ltfCustom]

// ============================================================================
// CISD STATE ENGINE (no drawing -> safe for request.security)
// Returns the most recently CONFIRMED delivery state:
//   1  = Bullish CISD confirmed (long delivery)
//  -1  = Bearish CISD confirmed (short delivery)
//   0  = not yet determined
// ============================================================================
f_cisdState() =>
    var float structTop    = high
    var float structBottom = low

    var bool isBullishPullback = false
    var bool isBearishPullback = false

    var float potentialTop    = na
    var float potentialBottom = na

    var int bullBreakIdx = na
    var int bearBreakIdx = na

    var float plusLevel  = na   // pending "+CISD" level (confirms Bullish)
    var float minusLevel = na   // pending "-CISD" level (confirms Bearish)
    var bool  plusActive  = false
    var bool  minusActive = false

    var int state = 0

    bearishPB = close[1] > open[1]
    bullishPB = close[1] < open[1]

    if bearishPB and not isBearishPullback
        isBearishPullback := true
        potentialTop := open[1]
        bullBreakIdx := bar_index[1]

    if bullishPB and not isBullishPullback
        isBullishPullback := true
        potentialBottom := open[1]
        bearBreakIdx := bar_index[1]

    if isBullishPullback
        if open < potentialBottom
            potentialBottom := open
            bearBreakIdx := bar_index
        if close < open and open > potentialBottom
            potentialBottom := open
            bearBreakIdx := bar_index

    if isBearishPullback
        if open > potentialTop
            potentialTop := open
            bullBreakIdx := bar_index
        if close > open and open < potentialTop
            potentialTop := open
            bullBreakIdx := bar_index

    // Bearish structure break -> arms a "+CISD" (bullish reversal) level
    if low < structBottom
        structBottom := low
        if isBearishPullback and (bar_index - bullBreakIdx != 0)
            structTop := math.max(high[bar_index - bullBreakIdx], high[bar_index - bullBreakIdx + 1])
            isBearishPullback := false
            plusLevel := potentialTop
            plusActive := true
        else if close[1] > open[1] and close < open
            structTop := high[1]
            isBearishPullback := false
            plusLevel := potentialTop
            plusActive := true

    // Bullish structure break -> arms a "-CISD" (bearish reversal) level
    if high > structTop
        structTop := high
        if isBullishPullback and (bar_index - bearBreakIdx != 0)
            structBottom := math.min(low[bar_index - bearBreakIdx], low[bar_index - bearBreakIdx + 1])
            isBullishPullback := false
            minusLevel := potentialBottom
            minusActive := true
        else if close[1] < open[1] and close > open
            structBottom := low[1]
            isBullishPullback := false
            minusLevel := potentialBottom
            minusActive := true

    if plusActive and close > plusLevel
        state := 1
        plusActive := false

    if minusActive and close < minusLevel
        state := -1
        minusActive := false

    state

// ============================================================================
// STRUCTURE ENGINE (BOS / CHoCH via fractal pivots)
// BOS   = Strukturbruch IN Trendrichtung (HH im Aufwärtstrend, LL im Abwärtstrend)
// CHoCH = erster Strukturbruch GEGEN den Trend (Trendwechsel)
// Returns: trend (1 bullish, -1 bearish, 0 undefined),
//          chochUp/chochDown, bosUp/bosDown, pivotPrice
// ============================================================================
f_structure(lbLen, rbLen) =>
    var int trend = 0
    var float lastPH = na
    var float lastPL = na
    bool chochUp = false
    bool chochDown = false
    bool bosUp = false
    bool bosDown = false
    float pivotPrice = na

    ph = ta.pivothigh(lbLen, rbLen)
    pl = ta.pivotlow(lbLen, rbLen)

    if not na(ph)
        if not na(lastPH) and ph > lastPH
            if trend == -1
                chochUp := true
            else if trend == 1
                bosUp := true
            trend := 1
        else if not na(lastPH) and ph <= lastPH and trend == 1
            chochDown := true
            trend := -1
        lastPH := ph
        pivotPrice := ph

    if not na(pl)
        if not na(lastPL) and pl < lastPL
            if trend == 1
                chochDown := true
            else if trend == -1
                bosDown := true
            trend := -1
        else if not na(lastPL) and pl >= lastPL and trend == -1
            chochUp := true
            trend := 1
        lastPL := pl
        pivotPrice := pl

    [trend, chochUp, chochDown, bosUp, bosDown, pivotPrice]

// ============================================================================
// MULTI-TIMEFRAME DATA
// ============================================================================

htfCISD_raw = request.security(syminfo.tickerid, htf, f_cisdState(), lookahead = barmerge.lookahead_off)
mtfCISD_raw = request.security(syminfo.tickerid, mtf, f_cisdState(), lookahead = barmerge.lookahead_off)
ltfCISD_raw = request.security(syminfo.tickerid, ltf, f_cisdState(), lookahead = barmerge.lookahead_off)

htfCISD = useConfirmed ? htfCISD_raw[1] : htfCISD_raw
mtfCISD = useConfirmed ? mtfCISD_raw[1] : mtfCISD_raw
ltfCISD = useConfirmed ? ltfCISD_raw[1] : ltfCISD_raw

[htfTrend_raw, htfChU_raw, htfChD_raw, htfBU_raw, htfBD_raw, _htfPP] = request.security(syminfo.tickerid, htf, f_structure(pivLeft, pivRight), lookahead = barmerge.lookahead_off)
[mtfTrend_raw, mtfChU_raw, mtfChD_raw, mtfBU_raw, mtfBD_raw, _mtfPP] = request.security(syminfo.tickerid, mtf, f_structure(pivLeft, pivRight), lookahead = barmerge.lookahead_off)
[ltfTrend_raw, ltfChU_raw, ltfChD_raw, ltfBU_raw, ltfBD_raw, _ltfPP] = request.security(syminfo.tickerid, ltf, f_structure(pivLeft, pivRight), lookahead = barmerge.lookahead_off)

htfTrend = useConfirmed ? htfTrend_raw[1] : htfTrend_raw
mtfTrend = useConfirmed ? mtfTrend_raw[1] : mtfTrend_raw
ltfTrend = useConfirmed ? ltfTrend_raw[1] : ltfTrend_raw

htfChU = useConfirmed ? htfChU_raw[1] : htfChU_raw
htfChD = useConfirmed ? htfChD_raw[1] : htfChD_raw
mtfChU = useConfirmed ? mtfChU_raw[1] : mtfChU_raw
mtfChD = useConfirmed ? mtfChD_raw[1] : mtfChD_raw
ltfChU = useConfirmed ? ltfChU_raw[1] : ltfChU_raw
ltfChD = useConfirmed ? ltfChD_raw[1] : ltfChD_raw

htfBU = useConfirmed ? htfBU_raw[1] : htfBU_raw
htfBD = useConfirmed ? htfBD_raw[1] : htfBD_raw
mtfBU = useConfirmed ? mtfBU_raw[1] : mtfBU_raw
mtfBD = useConfirmed ? mtfBD_raw[1] : mtfBD_raw
ltfBU = useConfirmed ? ltfBU_raw[1] : ltfBU_raw
ltfBD = useConfirmed ? ltfBD_raw[1] : ltfBD_raw

// ============================================================================
// FLOW LOGIC
// ============================================================================

allBull   = htfCISD == 1  and mtfCISD == 1  and ltfCISD == 1
allBear   = htfCISD == -1 and mtfCISD == -1 and ltfCISD == -1
htfMtfBull = htfCISD == 1  and mtfCISD == 1
htfMtfBear = htfCISD == -1 and mtfCISD == -1

flowText = allBull ? "LONGFLOW" : allBear ? "SHORTFLOW" : "MIXED"
flowColor = allBull ? color.new(color.green, 0) : allBear ? color.new(color.red, 0) : color.new(color.gray, 50)

flowDetail = allBull ? "Alle TFs bullish" :
     allBear ? "Alle TFs bearish" :
     htfMtfBull and ltfCISD == -1 ? "Pullback (Long Bias)" :
     htfMtfBear and ltfCISD == 1 ? "Pullback (Short Bias)" :
     "Uneinheitlich"

// ============================================================================
// CHART-TF: CISD DRAWING (lines / labels)
// ============================================================================

var float c_structTop    = high
var float c_structBottom = low

var bool c_isBullishPullback = false
var bool c_isBearishPullback = false

var float c_potentialTop    = na
var float c_potentialBottom = na

var int c_bullBreakIdx = na
var int c_bearBreakIdx = na

var line  plusLine   = na
var label plusLabel  = na
var line  minusLine  = na
var label minusLabel = na
var bool  plusActiveC  = false
var bool  minusActiveC = false

c_bearishPB = close[1] > open[1]
c_bullishPB = close[1] < open[1]

if c_bearishPB and not c_isBearishPullback
    c_isBearishPullback := true
    c_potentialTop := open[1]
    c_bullBreakIdx := bar_index[1]

if c_bullishPB and not c_isBullishPullback
    c_isBullishPullback := true
    c_potentialBottom := open[1]
    c_bearBreakIdx := bar_index[1]

if c_isBullishPullback
    if open < c_potentialBottom
        c_potentialBottom := open
        c_bearBreakIdx := bar_index
    if close < open and open > c_potentialBottom
        c_potentialBottom := open
        c_bearBreakIdx := bar_index

if c_isBearishPullback
    if open > c_potentialTop
        c_potentialTop := open
        c_bullBreakIdx := bar_index
    if close > open and open < c_potentialTop
        c_potentialTop := open
        c_bullBreakIdx := bar_index

if low < c_structBottom
    c_structBottom := low
    if c_isBearishPullback and (bar_index - c_bullBreakIdx != 0)
        c_structTop := math.max(high[bar_index - c_bullBreakIdx], high[bar_index - c_bullBreakIdx + 1])
        c_isBearishPullback := false
        if not keepLevels and not na(plusLine)
            line.delete(plusLine)
            label.delete(plusLabel)
        plusLine := line.new(c_bullBreakIdx, c_potentialTop, bar_index + lookAheadBars, c_potentialTop, color = bullishBreakColor, width = lineWidth, style = lineStyle)
        plusLabel := label.new(bar_index + lookAheadBars, c_potentialTop, bullStr, color = color.new(color.white, 100), textcolor = bullishBreakColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
        plusActiveC := true
    else if close[1] > open[1] and close < open
        c_structTop := high[1]
        c_isBearishPullback := false
        if not keepLevels and not na(plusLine)
            line.delete(plusLine)
            label.delete(plusLabel)
        plusLine := line.new(c_bullBreakIdx, c_potentialTop, bar_index + lookAheadBars, c_potentialTop, color = bullishBreakColor, width = lineWidth, style = lineStyle)
        plusLabel := label.new(bar_index + lookAheadBars, c_potentialTop, bullStr, color = color.new(color.white, 100), textcolor = bullishBreakColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
        plusActiveC := true

if high > c_structTop
    c_structTop := high
    if c_isBullishPullback and (bar_index - c_bearBreakIdx != 0)
        c_structBottom := math.min(low[bar_index - c_bearBreakIdx], low[bar_index - c_bearBreakIdx + 1])
        c_isBullishPullback := false
        if not keepLevels and not na(minusLine)
            line.delete(minusLine)
            label.delete(minusLabel)
        minusLine := line.new(c_bearBreakIdx, c_potentialBottom, bar_index + lookAheadBars, c_potentialBottom, color = bearishBreakColor, width = lineWidth, style = lineStyle)
        minusLabel := label.new(bar_index + lookAheadBars, c_potentialBottom, bearStr, color = color.new(color.white, 100), textcolor = bearishBreakColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
        minusActiveC := true
    else if close[1] < open[1] and close > open
        c_structBottom := low[1]
        c_isBullishPullback := false
        if not keepLevels and not na(minusLine)
            line.delete(minusLine)
            label.delete(minusLabel)
        minusLine := line.new(c_bearBreakIdx, c_potentialBottom, bar_index + lookAheadBars, c_potentialBottom, color = bearishBreakColor, width = lineWidth, style = lineStyle)
        minusLabel := label.new(bar_index + lookAheadBars, c_potentialBottom, bearStr, color = color.new(color.white, 100), textcolor = bearishBreakColor, style = label.style_label_left, size = size.small, text_formatting = text.format_italic)
        minusActiveC := true

if plusActiveC
    line.set_x2(plusLine, bar_index + lookAheadBars)
    label.set_x(plusLabel, bar_index + lookAheadBars)
    if close > line.get_y2(plusLine)
        plusActiveC := false
        if bullishAlerts
            alert("Bullish CISD confirmed (" + syminfo.ticker + ", " + timeframe.period + ")", alert.freq_once_per_bar_close)

if minusActiveC
    line.set_x2(minusLine, bar_index + lookAheadBars)
    label.set_x(minusLabel, bar_index + lookAheadBars)
    if close < line.get_y2(minusLine)
        minusActiveC := false
        if bearishAlerts
            alert("Bearish CISD confirmed (" + syminfo.ticker + ", " + timeframe.period + ")", alert.freq_once_per_bar_close)

// ============================================================================
// CHART-TF: CHoCH MARKERS
// ============================================================================

[_chartTrend, chochUp, chochDown, bosUp, bosDown, pivotPrice] = f_structure(pivLeft, pivRight)

if showStructureBreaks and chochUp
    label.new(bar_index - pivRight, pivotPrice, "CHoCH▲", style = label.style_label_up, color = color.new(color.white, 100), textcolor = color.lime, size = size.tiny, text_formatting = text.format_bold)

if showStructureBreaks and chochDown
    label.new(bar_index - pivRight, pivotPrice, "CHoCH▼", style = label.style_label_down, color = color.new(color.white, 100), textcolor = color.red, size = size.tiny, text_formatting = text.format_bold)

if showStructureBreaks and bosUp
    label.new(bar_index - pivRight, pivotPrice, "BOS▲", style = label.style_label_up, color = color.new(color.white, 100), textcolor = color.new(color.lime, 40), size = size.tiny)

if showStructureBreaks and bosDown
    label.new(bar_index - pivRight, pivotPrice, "BOS▼", style = label.style_label_down, color = color.new(color.white, 100), textcolor = color.new(color.red, 40), size = size.tiny)

// ============================================================================
// FLOW ALERTS
// ============================================================================

var int prevFlow = 0
curFlow = allBull ? 1 : allBear ? -1 : 0

if alertOnFlowChange and curFlow != prevFlow and curFlow != 0
    alert("Flow-Wechsel: " + (curFlow == 1 ? "LONGFLOW" : "SHORTFLOW") + " (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
prevFlow := curFlow

ltfFlipToLong  = htfCISD == 1  and mtfCISD == 1  and ltfCISD == 1  and ltfCISD[1] != 1
ltfFlipToShort = htfCISD == -1 and mtfCISD == -1 and ltfCISD == -1 and ltfCISD[1] != -1

if alertOnLTFFlip and (ltfFlipToLong or ltfFlipToShort)
    alert("LTF CISD Flip in Trendrichtung (" + (ltfFlipToLong ? "Long" : "Short") + ") - " + syminfo.ticker, alert.freq_once_per_bar_close)

// ============================================================================
// TRUE OPENS (TDO 00:00 / NYAM 09:30 NY) + NDOG/NWOG opening gaps
// ============================================================================

var line  tdoLine = na
var label tdoLbl  = na
if showTDOln and f_cross(0, 0)
    line.delete(tdoLine), label.delete(tdoLbl)
    tdoLine := line.new(bar_index, open, bar_index + lookAheadBars, open, color = colTDOln, style = line.style_dotted)
    tdoLbl  := label.new(bar_index + lookAheadBars, open, "TDO", style = label.style_label_left, color = color.new(color.white, 100), textcolor = colTDOln, size = size.tiny)
if not na(tdoLine)
    line.set_x2(tdoLine, bar_index + lookAheadBars), label.set_x(tdoLbl, bar_index + lookAheadBars)

var line  nyamLine = na
var label nyamLbl  = na
if showNYAMln and f_cross(9, 30)
    line.delete(nyamLine), label.delete(nyamLbl)
    nyamLine := line.new(bar_index, open, bar_index + lookAheadBars, open, color = colNYAMln, style = line.style_dotted)
    nyamLbl  := label.new(bar_index + lookAheadBars, open, "NYAM", style = label.style_label_left, color = color.new(color.white, 100), textcolor = colNYAMln, size = size.tiny)
if not na(nyamLine)
    line.set_x2(nyamLine, bar_index + lookAheadBars), label.set_x(nyamLbl, bar_index + lookAheadBars)

// Opening gaps at the 18:00 NY futures reopen: Sunday = NWOG, Mon-Thu = NDOG.
// Only the most recent gap of each type is kept (the classic draw-on-liquidity target).
var box   ndogBox = na
var box   nwogBox = na
var float ndogMid = na
var float nwogMid = na

if f_cross(18, 0) and not na(close[1]) and open != close[1]
    float gTop = math.max(open, close[1])
    float gBot = math.min(open, close[1])
    if dayofweek(time, TZ) == dayofweek.sunday
        nwogMid := (gTop + gBot) / 2.0
        box.delete(nwogBox)
        if showGapBoxes
            nwogBox := box.new(bar_index, gTop, bar_index + lookAheadBars, gBot, bgcolor = color.new(nwogColIn, 88), border_color = color.new(nwogColIn, 40), border_style = line.style_dotted, text = "NWOG", text_size = size.tiny, text_color = color.new(nwogColIn, 30), text_halign = text.align_right)
    else if dayofweek(time, TZ) >= dayofweek.monday and dayofweek(time, TZ) <= dayofweek.thursday
        ndogMid := (gTop + gBot) / 2.0
        box.delete(ndogBox)
        if showGapBoxes
            ndogBox := box.new(bar_index, gTop, bar_index + lookAheadBars, gBot, bgcolor = color.new(ndogColIn, 88), border_color = color.new(ndogColIn, 40), border_style = line.style_dotted, text = "NDOG", text_size = size.tiny, text_color = color.new(ndogColIn, 30), text_halign = text.align_right)

if not na(ndogBox)
    box.set_right(ndogBox, bar_index + lookAheadBars)
if not na(nwogBox)
    box.set_right(nwogBox, bar_index + lookAheadBars)

// ============================================================================
// RISK MODULE: ATR/ADX-adaptive SL/TP + position sizing
// ============================================================================

atrVal = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

// 0 = Chop, 1 = Trend, smooth interpolation in between
trendFactor = math.min(math.max((adxVal - adxChopTh) / math.max(adxTrendTh - adxChopTh, 0.1), 0.0), 1.0)
regimeText  = adxVal >= adxTrendTh ? "Trend" : adxVal <= adxChopTh ? "Chop" : "Neutral"

// Stop slightly wider in trend regime (price breathes more), TP scales from rrChop to rrTrend
slMult  = slMultBase * (1.0 + 0.3 * trendFactor)
rrRatio = rrChop + (rrTrend - rrChop) * trendFactor

stopDist = atrVal * slMult
tpDist   = stopDist * rrRatio

// Position sizing: risk budget / (stop distance in points * $ per point)
riskMoney  = accountSize * riskPct / 100.0
pointValue = switch pvOverride
    "MNQ ($2)"     => 2.0
    "NQ ($20)"     => 20.0
    "MES ($5)"     => 5.0
    "ES ($50)"     => 50.0
    "MYM ($0.50)"  => 0.5
    "YM ($5)"      => 5.0
    "M2K ($5)"     => 5.0
    "RTY ($50)"    => 50.0
    "MGC ($10)"    => 10.0
    "GC ($100)"    => 100.0
    "MCL ($100)"   => 100.0
    "CL ($1000)"   => 1000.0
    "Custom"       => pvCustom
    => syminfo.pointvalue
rawContracts = stopDist > 0 and pointValue > 0 ? math.floor(riskMoney / (stopDist * pointValue)) : 0
contracts    = math.min(rawContracts, maxContracts)
riskActual   = contracts * stopDist * pointValue

// ============================================================================
// QUARTER THEORY: deterministic NY-time quarter slots
// 90m: anchored 19:00 NY (Q1-Q4 per session) | 6H: anchored 18:00 NY
// Daily: Sun-Wed = Q1-Q4 (CME week)          | Weekly: week of month
// ============================================================================

t1900  = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), 19, 0)
base90 = time >= t1900 ? t1900 : timestamp(TZ, year(time - 86400000, TZ), month(time - 86400000, TZ), dayofmonth(time - 86400000, TZ), 19, 0)
slot90 = int(math.floor((time - base90) / 5400000))
q90    = slot90 >= 0 and slot90 < 16 ? slot90 % 4 + 1 : 0
key90  = base90 + slot90 * 5400000

t1800 = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), 18, 0)
base6 = time >= t1800 ? t1800 : timestamp(TZ, year(time - 86400000, TZ), month(time - 86400000, TZ), dayofmonth(time - 86400000, TZ), 18, 0)
slot6 = math.max(0, math.min(int(math.floor((time - base6) / 21600000)), 3))
q6    = slot6 + 1
key6  = base6 + slot6 * 21600000

dowNY = dayofweek(time, TZ)
qD = dowNY == dayofweek.sunday ? 1 : dowNY == dayofweek.monday ? 2 : dowNY == dayofweek.tuesday ? 3 : dowNY == dayofweek.wednesday ? 4 : 0
nyDayKey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)

qW = math.min(int(math.floor((dayofmonth(time, TZ) - 1) / 7)) + 1, 4)
keyW = year(time, TZ) * 1000 + month(time, TZ) * 10 + qW

f_qTxt(int q) => q > 0 ? "Q" + str.tostring(q) : "–"

// ============================================================================
// ORDERFLOW / DELTA: Buy-Sell-Volumen, Session-CVD, Absorption
// Quelle A: request.footprint (echtes Bid/Ask, Premium/Ultimate)
// Quelle B: 1m Up/Down-Klassifikation (alle Pläne)
// ============================================================================

[ofOpens, ofCloses, ofVolumes] = request.security_lower_tf(syminfo.tickerid, "1", [open, close, volume])

float upVol = 0.0
float dnVol = 0.0
float barDelta = na
float halfDelta = na

// 1m delta path is always computed (also as flip basis in footprint mode):
// halfDelta = cumulative delta after the first half of the bar.
int nOf = array.size(ofCloses)
float bigV    = na
float bigPx   = na
int   bigDir  = 0
if nOf > 0
    int half = math.max(1, nOf / 2)
    float run = 0.0
    for i = 0 to nOf - 1
        float c = array.get(ofCloses, i)
        float o = array.get(ofOpens, i)
        float v = nz(array.get(ofVolumes, i))
        if c > o
            upVol += v
            run += v
        else if c < o
            dnVol += v
            run -= v
        else
            upVol += v / 2.0
            dnVol += v / 2.0
        if i == half - 1
            halfDelta := run
        if na(bigV) or v > bigV
            bigV   := v
            bigPx  := c
            bigDir := c > o ? 1 : c < o ? -1 : 0
    barDelta := upVol - dnVol

// Rolling average 1m volume per bar (for "big print" comparison)
var float avg1mVol = na
float thisAvg1m = nOf > 0 ? volume / nOf : na
if not na(thisAvg1m)
    avg1mVol := na(avg1mVol) ? thisAvg1m : avg1mVol + (thisAvg1m - avg1mVol) / 20.0

bool bigTrade = showBigTrades and not na(bigV) and not na(avg1mVol) and bigV > avg1mVol * bigTradeMult
if bigTrade
    color bigCol = bigDir == 1 ? color.new(color.lime, 0) : bigDir == -1 ? color.new(color.red, 0) : color.new(#9598a1, 0)
    label.new(bar_index, bigPx, "●", style = label.style_label_center, color = color.new(color.white, 100), textcolor = bigCol, size = size.small, tooltip = "Großer Print: " + str.tostring(bigV, format.volume) + " (Ø " + str.tostring(avg1mVol, format.volume) + ")")

if deltaSrcIn == "Footprint Bid/Ask (Premium/Ultimate)"
    footprint fp = request.footprint(fpTicksRow)
    if not na(fp)
        upVol := fp.buy_volume()
        dnVol := fp.sell_volume()
        barDelta := fp.delta()

// Intrabar delta flip: first half of the bar one-sided, close the other way.
//  -1 = started positive, ended negative (sellers took over)
//  +1 = started negative, ended positive (buyers took over)
int deltaFlip = nz(halfDelta) > 0 and nz(barDelta) < 0 ? -1 : nz(halfDelta) < 0 and nz(barDelta) > 0 ? 1 : 0

// Session-anchored CVD (reset at the 18:00 NY reopen)
var float cvd = 0.0
if f_cross(18, 0)
    cvd := 0.0
cvd += nz(barDelta)

// Absorption: hohes Volumen + kleine Range + Aggression gegen die Schlussrichtung
// bullAbsorb = aggressive Verkäufer werden am Level absorbiert (stützt Longs)
// bearAbsorb = aggressive Käufer werden absorbiert (stützt Shorts)
volSma = ta.sma(volume, 20)
bool highVolBar = volume > volSma * 1.5
bool smallRange = (high - low) < atrVal * 0.7
bool bullAbsorb = highVolBar and smallRange and nz(barDelta) < 0 and close >= open
bool bearAbsorb = highVolBar and smallRange and nz(barDelta) > 0 and close <= open
int sinceBullAbs = nz(ta.barssince(bullAbsorb), 9999)
int sinceBearAbs = nz(ta.barssince(bearAbsorb), 9999)

// Per-candle delta labels (rolling window of the last N bars). A flip inside
// the bar is shown as +→− (sellers took over) or −→+ (buyers took over).
var label[] dLbls = array.new_label()
if showDeltaCandles and not na(barDelta)
    string flipTxt = deltaFlip == -1 ? "\n+→−" : deltaFlip == 1 ? "\n−→+" : ""
    color dCol = deltaFlip != 0 ? color.new(color.yellow, 0) : barDelta > 0 ? color.new(color.lime, 15) : barDelta < 0 ? color.new(color.red, 15) : color.new(#9598a1, 0)
    array.push(dLbls, label.new(bar_index, low, (barDelta >= 0 ? "+" : "") + str.tostring(barDelta, format.volume) + flipTxt, style = label.style_label_up, color = color.new(color.white, 100), textcolor = dCol, size = size.tiny))
    while array.size(dLbls) > deltaLblCount
        label.delete(array.shift(dLbls))

// ============================================================================
// TRAPPED BUYERS / SELLERS: a breakout above/below a recent pivot on elevated
// volume that gets reclaimed within a few bars - the breakout traders are
// now stuck in a loss and may have to capitulate, fueling a reversal.
// ============================================================================
float recentHigh = ta.highest(high[1], trapLookback)
float recentLow  = ta.lowest(low[1], trapLookback)

var int   trapDir   = 0
var float trapLevel = na
var int   trapStart = na

if showTraps
    if trapDir == 0
        if high > recentHigh and volume > volSma * trapVolMult
            trapDir   := 1
            trapLevel := recentHigh
            trapStart := bar_index
        else if low < recentLow and volume > volSma * trapVolMult
            trapDir   := -1
            trapLevel := recentLow
            trapStart := bar_index
    else
        bool reclaimed = trapDir == 1 ? close < trapLevel : close > trapLevel
        if reclaimed
            color trapCol = trapDir == 1 ? color.new(color.red, 0) : color.new(color.lime, 0)
            line.new(trapStart, trapLevel, bar_index + lookAheadBars, trapLevel, color = trapCol, style = line.style_dashed, width = 1)
            label.new(bar_index, trapLevel, trapDir == 1 ? "Trapped Longs" : "Trapped Shorts", style = trapDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.white, 100), textcolor = trapCol, size = size.small)
            trapDir := 0
        else if bar_index - trapStart > trapConfirmBars
            trapDir := 0

// Does the orderflow (CVD direction + recent absorption) confirm a trade in
// direction `dir` (1 = long, -1 = short)?
f_deltaOk(int dir) =>
    bool cvdAgrees   = dir == 1 ? cvd > 0 : cvd < 0
    bool absAgainst  = dir == 1 ? (sinceBearAbs <= 5 and sinceBearAbs <= sinceBullAbs) : (sinceBullAbs <= 5 and sinceBullAbs <= sinceBearAbs)
    cvdAgrees and not absAgainst

// Killzones: is the current bar inside an enabled NY session window?
int nyMin = hour(time, TZ) * 60 + minute(time, TZ)
bool inKZ = (kzLondon and nyMin >= 120 and nyMin < 300) or (kzNYAM and nyMin >= 570 and nyMin < 720) or (kzNYPM and nyMin >= 810 and nyMin < 960)

// CVD-Divergenz: Preis macht ein höheres Pivot-Hoch, das Session-CVD aber
// nicht (bearish) - bzw. tieferes Pivot-Tief ohne neues CVD-Tief (bullish).
float divPH = ta.pivothigh(high, pivLeft, pivRight)
float divPL = ta.pivotlow(low, pivLeft, pivRight)
var float lastDivPH    = na
var float lastDivPHcvd = na
var float lastDivPL    = na
var float lastDivPLcvd = na
bool bearDiv = false
bool bullDiv = false
if not na(divPH)
    float cvdAtPH = cvd[pivRight]
    if not na(lastDivPH) and divPH > lastDivPH and cvdAtPH < lastDivPHcvd
        bearDiv := true
    lastDivPH    := divPH
    lastDivPHcvd := cvdAtPH
if not na(divPL)
    float cvdAtPL = cvd[pivRight]
    if not na(lastDivPL) and divPL < lastDivPL and cvdAtPL > lastDivPLcvd
        bullDiv := true
    lastDivPL    := divPL
    lastDivPLcvd := cvdAtPL

plotshape(showCvdDiv and bearDiv, "CVD Divergenz Bear", style = shape.diamond, location = location.abovebar, color = color.new(color.fuchsia, 0), size = size.tiny, offset = -pivRight)
plotshape(showCvdDiv and bullDiv, "CVD Divergenz Bull", style = shape.diamond, location = location.belowbar, color = color.new(color.aqua, 0), size = size.tiny, offset = -pivRight)

// Volume profile levels (assigned in the VP section below, persisted across bars)
var float pocPxG = na
var float vahPxG = na
var float valPxG = na

// Trade setup state machine: drawn at LTF flip (only if sizable), then either
// TP hit / SL hit / flow invalidation / timeout -> levels are grayed out.
var line  entryLine = na
var line  slLine    = na
var line  tpLine    = na
var label entryLbl  = na
var label slLbl     = na
var label tpLbl     = na

var int   tradeDir      = 0
var float tradeSL       = na
var float tradeTP       = na
var int   tradeStartBar = na
var float tradeEntry    = na
var float tradeR        = na
var bool  beFlagged     = false

// Setup statistics across the loaded chart history
var int   statWins  = 0
var int   statLoss  = 0
var int   statOther = 0
var float statSumR  = 0.0

// Optional FVG entry: after a flip, wait for the first fair value gap in trade
// direction and enter at its midpoint instead of the flip close.
var int fvgScanDir   = 0
var int fvgScanStart = na
var box entryZone    = na

bool flipSignal = showTradeLevels and (ltfFlipToLong or ltfFlipToShort)
bool bullFvgNow = low > high[2]
bool bearFvgNow = high < low[2]

int   sigDir  = 0
float entryPx = na

if flipSignal
    if fvgEntryMode
        fvgScanDir   := ltfFlipToLong ? 1 : -1
        fvgScanStart := bar_index
    else if contracts > 0
        sigDir  := ltfFlipToLong ? 1 : -1
        entryPx := close
else if fvgScanDir != 0
    if curFlow != fvgScanDir or bar_index - fvgScanStart > fvgScanBars
        fvgScanDir := 0
    else if (fvgScanDir == 1 and bullFvgNow) or (fvgScanDir == -1 and bearFvgNow)
        float zTop = fvgScanDir == 1 ? low : low[2]
        float zBot = fvgScanDir == 1 ? high[2] : high
        box.delete(entryZone)
        entryZone := box.new(bar_index - 2, zTop, bar_index + lookAheadBars, zBot, bgcolor = color.new(color.blue, 88), border_color = color.new(color.blue, 45), border_style = line.style_dotted, text = "FVG Entry", text_size = size.tiny, text_color = color.new(color.blue, 30), text_halign = text.align_right)
        if contracts > 0
            sigDir  := fvgScanDir
            entryPx := (zTop + zBot) / 2.0
        fvgScanDir := 0

// Orderflow confirmation: optionally warn or block when CVD/absorption
// contradicts the signal direction.
string deltaWarn = ""
if sigDir != 0 and deltaFilterMode != "Aus" and not f_deltaOk(sigDir)
    if deltaFilterMode == "Blocken"
        sigDir := 0
    else
        deltaWarn := " Δ⚠"

// Killzone confirmation: warn or block signals outside the enabled sessions.
if sigDir != 0 and kzFilterMode != "Aus" and not inKZ
    if kzFilterMode == "Blocken"
        sigDir := 0
    else
        deltaWarn += " KZ⚠"

bool newSignal = sigDir != 0

if newSignal
    dirSign  = sigDir
    slPx     = entryPx - dirSign * stopDist
    tpPx     = entryPx + dirSign * tpDist
    bool snapped = false
    if tpSnap
        float[] vpLvls = array.from(pocPxG, vahPxG, valPxG, gapSnap ? ndogMid : na, gapSnap ? nwogMid : na)
        float bestDiff = -1.0
        for i = 0 to 4
            float lvl = array.get(vpLvls, i)
            if not na(lvl)
                float dist = (lvl - entryPx) * dirSign
                if dist >= 0.8 * tpDist and dist <= 1.5 * tpDist
                    float diff = math.abs(dist - tpDist)
                    if bestDiff < 0 or diff < bestDiff
                        bestDiff := diff
                        tpPx := lvl
                        snapped := true
    rrEff = stopDist > 0 ? math.abs(tpPx - entryPx) / stopDist : rrRatio
    // Confluence score (0-7): how many independent factors back this signal?
    int score = 0
    score += htfCISD == dirSign ? 1 : 0
    score += mtfTrend == dirSign ? 1 : 0
    score += (dirSign == 1 ? cvd > 0 : cvd < 0) ? 1 : 0
    score += (dirSign == 1 ? sinceBullAbs <= 10 : sinceBearAbs <= 10) ? 1 : 0
    score += inKZ ? 1 : 0
    score += (q90 == 2 or q90 == 3) ? 1 : 0
    float[] cfLvls = array.from(pocPxG, vahPxG, valPxG, ndogMid, nwogMid)
    float minLvlDist = na
    for i = 0 to 4
        float l = array.get(cfLvls, i)
        if not na(l)
            float d = math.abs(entryPx - l)
            if na(minLvlDist) or d < minLvlDist
                minLvlDist := d
    score += not na(minLvlDist) and minLvlDist <= atrVal * 0.5 ? 1 : 0
    string scoreTxt = showScore ? "  ·  Score " + str.tostring(score) + "/7" : ""
    line.delete(entryLine), label.delete(entryLbl)
    line.delete(slLine),    label.delete(slLbl)
    line.delete(tpLine),    label.delete(tpLbl)
    entryLine := line.new(bar_index, entryPx, bar_index + lookAheadBars, entryPx, color = color.new(color.blue, 0), width = lineWidth, style = line.style_solid)
    slLine    := line.new(bar_index, slPx, bar_index + lookAheadBars, slPx, color = color.new(color.red, 0), width = lineWidth, style = line.style_dashed)
    tpLine    := line.new(bar_index, tpPx, bar_index + lookAheadBars, tpPx, color = color.new(color.green, 0), width = lineWidth, style = line.style_dashed)
    entryLbl  := label.new(bar_index + lookAheadBars, entryPx, "Entry " + str.tostring(entryPx, format.mintick) + (fvgEntryMode ? " (FVG)" : "") + " | " + str.tostring(contracts) + "x" + scoreTxt + deltaWarn, style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.blue, size = size.small)
    slLbl     := label.new(bar_index + lookAheadBars, slPx, "SL " + str.tostring(slPx, format.mintick) + " (" + str.tostring(slMult, "#.#") + "×ATR)", style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.red, size = size.small)
    tpLbl     := label.new(bar_index + lookAheadBars, tpPx, "TP " + str.tostring(tpPx, format.mintick) + " (" + str.tostring(rrEff, "#.#") + "R" + (snapped ? ", VP-Level" : "") + ")", style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.green, size = size.small)
    tradeDir      := dirSign
    tradeSL       := slPx
    tradeTP       := tpPx
    tradeStartBar := bar_index
    tradeEntry    := entryPx
    tradeR        := math.abs(entryPx - slPx)
    beFlagged     := false
else if tradeDir != 0
    // Break-even hint: once the setup has been 1R in profit, suggest moving SL
    if beHint and not beFlagged and tradeR > 0 and ((tradeDir == 1 and high >= tradeEntry + tradeR) or (tradeDir == -1 and low <= tradeEntry - tradeR))
        beFlagged := true
        line.set_color(entryLine, color.new(color.teal, 0))
        label.set_text(entryLbl, label.get_text(entryLbl) + "  [BE möglich]")
    string endStatus = na
    if (tradeDir == 1 and low <= tradeSL) or (tradeDir == -1 and high >= tradeSL)
        endStatus := "SL hit"
    else if (tradeDir == 1 and high >= tradeTP) or (tradeDir == -1 and low <= tradeTP)
        endStatus := "TP hit ✓"
    else if curFlow != tradeDir
        endStatus := "invalidiert (Flow)"
    else if bar_index - tradeStartBar > tradeTimeoutBars
        endStatus := "Timeout"
    if not na(endStatus)
        grayCol = color.new(color.gray, 55)
        line.set_color(entryLine, grayCol), line.set_color(slLine, grayCol), line.set_color(tpLine, grayCol)
        label.set_textcolor(entryLbl, grayCol), label.set_textcolor(slLbl, grayCol), label.set_textcolor(tpLbl, grayCol)
        label.set_text(entryLbl, label.get_text(entryLbl) + "  [" + endStatus + "]")
        // Statistics: TP = full target R, SL = -1R, otherwise mark-to-market R
        if tradeR > 0
            float closedR = endStatus == "TP hit ✓" ? math.abs(tradeTP - tradeEntry) / tradeR : endStatus == "SL hit" ? -1.0 : (close - tradeEntry) * tradeDir / tradeR
            statSumR += closedR
        if endStatus == "TP hit ✓"
            statWins += 1
        else if endStatus == "SL hit"
            statLoss += 1
        else
            statOther += 1
        tradeDir := 0

if not na(entryLine) and tradeDir != 0
    line.set_x2(entryLine, bar_index + lookAheadBars), label.set_x(entryLbl, bar_index + lookAheadBars)
    line.set_x2(slLine, bar_index + lookAheadBars),    label.set_x(slLbl, bar_index + lookAheadBars)
    line.set_x2(tpLine, bar_index + lookAheadBars),    label.set_x(tpLbl, bar_index + lookAheadBars)
    if not na(entryZone)
        box.set_right(entryZone, bar_index + lookAheadBars)

// ============================================================================
// QUARTER VOLUME PROFILE: POC / VAH / VAL of the current quarter
// 1m volume is bucketed into price bins (bin size fixed at quarter start),
// POC = max-volume bin, VA expands from POC until vpValueArea% is covered.
// ============================================================================

[vpCloses, vpVolumes] = request.security_lower_tf(syminfo.tickerid, "1", [close, volume])

int vpKey = vpCycle == "90m" ? key90 : vpCycle == "6H" ? key6 : vpCycle == "Daily" ? nyDayKey : keyW

var float[] vpVols  = array.new_float()
var int   vpBase    = na
var float vpStep    = na
var int   vpStartT  = na
var int   vpLastKey = na

var line  pocLine = na
var line  vahLine = na
var line  valLine = na
var label pocLbl  = na
var line[] hvnLines = array.new_line()

if showVP
    if na(vpLastKey) or vpKey != vpLastKey
        vpLastKey := vpKey
        array.clear(vpVols)
        vpBase   := na
        vpStep   := math.max(nz(atrVal, syminfo.mintick * 10) / 4.0, syminfo.mintick)
        vpStartT := time

    int nSub = array.size(vpCloses)
    if nSub > 0 and not na(vpStep)
        for i = 0 to nSub - 1
            float c = array.get(vpCloses, i)
            float v = nz(array.get(vpVolumes, i))
            int idx = int(math.round(c / vpStep))
            if na(vpBase)
                vpBase := idx
                array.push(vpVols, v)
            else
                while idx < vpBase and array.size(vpVols) < 4000
                    array.unshift(vpVols, 0.0)
                    vpBase := vpBase - 1
                while idx > vpBase + array.size(vpVols) - 1 and array.size(vpVols) < 4000
                    array.push(vpVols, 0.0)
                int off = idx - vpBase
                if off >= 0 and off < array.size(vpVols)
                    array.set(vpVols, off, array.get(vpVols, off) + v)

    int sz = array.size(vpVols)
    if sz > 0
        int pocOff = 0
        float pocV = -1.0
        float totV = 0.0
        for i = 0 to sz - 1
            float v = array.get(vpVols, i)
            totV += v
            if v > pocV
                pocV := v
                pocOff := i
        float vaTarget = totV * vpValueArea / 100.0
        float vaAcc = pocV
        int lo = pocOff
        int hi = pocOff
        while vaAcc < vaTarget and (lo > 0 or hi < sz - 1)
            float vLo = lo > 0 ? array.get(vpVols, lo - 1) : -1.0
            float vHi = hi < sz - 1 ? array.get(vpVols, hi + 1) : -1.0
            if vHi >= vLo
                hi += 1
                vaAcc += math.max(vHi, 0.0)
            else
                lo -= 1
                vaAcc += math.max(vLo, 0.0)
        float pocPx = (vpBase + pocOff) * vpStep
        float vahPx = (vpBase + hi) * vpStep
        float valPx = (vpBase + lo) * vpStep
        pocPxG := pocPx
        vahPxG := vahPx
        valPxG := valPx

        // High-volume nodes outside the value area: local volume peaks that
        // could hold resting limit liquidity / act as support-resistance.
        while array.size(hvnLines) > 0
            line.delete(array.pop(hvnLines))
        if showHVN
            float hvnTarget = pocV * hvnThresh / 100.0
            for i = 1 to sz - 2
                if (i < lo or i > hi) and i != pocOff
                    float v = array.get(vpVols, i)
                    if v >= hvnTarget and v > array.get(vpVols, i - 1) and v > array.get(vpVols, i + 1) and array.size(hvnLines) < 4
                        float hvnPx = (vpBase + i) * vpStep
                        array.push(hvnLines, line.new(vpStartT, hvnPx, time, hvnPx, xloc = xloc.bar_time, color = color.new(#9598a1, 30), style = line.style_dotted, width = 1))

        if na(pocLine)
            pocLine := line.new(vpStartT, pocPx, time, pocPx, xloc = xloc.bar_time, color = vpPocColor, width = 2)
            vahLine := line.new(vpStartT, vahPx, time, vahPx, xloc = xloc.bar_time, color = vpVaColor, style = line.style_dotted)
            valLine := line.new(vpStartT, valPx, time, valPx, xloc = xloc.bar_time, color = vpVaColor, style = line.style_dotted)
            pocLbl  := label.new(time, pocPx, "POC " + vpCycle, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = vpPocColor, size = size.tiny)
        else
            line.set_xy1(pocLine, vpStartT, pocPx), line.set_xy2(pocLine, time, pocPx)
            line.set_xy1(vahLine, vpStartT, vahPx), line.set_xy2(vahLine, time, vahPx)
            line.set_xy1(valLine, vpStartT, valPx), line.set_xy2(valLine, time, valPx)
            label.set_xy(pocLbl, time, pocPx)
else if not na(pocLine)
    line.delete(pocLine), line.delete(vahLine), line.delete(valLine), label.delete(pocLbl)
    pocLine := na
    while array.size(hvnLines) > 0
        line.delete(array.pop(hvnLines))

// ============================================================================
// DASHBOARD (compact)
// ============================================================================

f_glyph(int s) => s == 1 ? "▲" : s == -1 ? "▼" : "·"
f_glyphCol(int s) => s == 1 ? color.new(color.lime, 0) : s == -1 ? color.new(color.red, 0) : color.new(#9598a1, 0)

// Bars since the CISD state last flipped (counted in chart bars)
var int htfFlipAt = 0
var int mtfFlipAt = 0
var int ltfFlipAt = 0
if htfCISD != htfCISD[1]
    htfFlipAt := bar_index
if mtfCISD != mtfCISD[1]
    mtfFlipAt := bar_index
if ltfCISD != ltfCISD[1]
    ltfFlipAt := bar_index

f_cisdCell(int s, int flipAt) => f_glyph(s) + " " + str.tostring(bar_index - flipAt)

f_structTxt(int trend, bool chU, bool chD, bool bU, bool bD) =>
    g = trend == 1 ? "▲" : trend == -1 ? "▼" : "·"
    chU or chD ? g + " CHoCH" : bU or bD ? g + " BOS" : g

mutedCol = color.new(#b2b5be, 0)
strongCol = color.new(#d1d4dc, 0)

if showTable and barstate.islast
    int rNext = 6
    int rOF = rNext
    if showDeltaRow
        rNext += 1
    int rStat = rNext
    if showStatsRow
        rNext += 1
    int rSize = rNext
    int rAcc  = rNext + 1
    int tblRows = rNext + 2
    var table tbl = table.new(f_tablePos(tablePosition), 4, tblRows, bgcolor = color.new(#1e222d, 0), frame_color = color.new(#363a45, 0), frame_width = 1, border_width = 0)
    var bool tblMerged = false
    if not tblMerged
        table.merge_cells(tbl, 0, 0, 3, 0)
        table.merge_cells(tbl, 0, 5, 3, 5)
        if showDeltaRow
            table.merge_cells(tbl, 0, rOF, 3, rOF)
        if showStatsRow
            table.merge_cells(tbl, 0, rStat, 3, rStat)
        table.merge_cells(tbl, 0, rSize, 3, rSize)
        table.merge_cells(tbl, 0, rAcc, 3, rAcc)
        tblMerged := true

    // Header: ticker + flow as one colored strip
    table.cell(tbl, 0, 0, syminfo.ticker + "   " + flowText, text_color = color.white, bgcolor = flowColor, text_size = tSize, text_formatting = text.format_bold)

    // Column headers
    table.cell(tbl, 0, 1, "TF", text_color = mutedCol, text_size = size.tiny, text_formatting = text.format_bold)
    table.cell(tbl, 1, 1, "CISD", text_color = mutedCol, text_size = size.tiny, text_formatting = text.format_bold)
    table.cell(tbl, 2, 1, "Strukt", text_color = mutedCol, text_size = size.tiny, text_formatting = text.format_bold)

    // TF rows: HTF -> Weekly Q, MTF -> Daily Q, LTF -> 6H Q
    table.cell(tbl, 0, 2, htf, text_color = strongCol, text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 1, 2, f_cisdCell(htfCISD, htfFlipAt), text_color = f_glyphCol(htfCISD), text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 2, 2, f_structTxt(htfTrend, htfChU, htfChD, htfBU, htfBD), text_color = f_glyphCol(htfTrend), text_size = tSize)
    if showQT
        table.cell(tbl, 3, 2, "W " + f_qTxt(qW), text_color = mutedCol, text_size = tSize)

    table.cell(tbl, 0, 3, mtf, text_color = strongCol, text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 1, 3, f_cisdCell(mtfCISD, mtfFlipAt), text_color = f_glyphCol(mtfCISD), text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 2, 3, f_structTxt(mtfTrend, mtfChU, mtfChD, mtfBU, mtfBD), text_color = f_glyphCol(mtfTrend), text_size = tSize)
    if showQT
        table.cell(tbl, 3, 3, "D " + f_qTxt(qD), text_color = mutedCol, text_size = tSize)

    table.cell(tbl, 0, 4, ltf, text_color = strongCol, text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 1, 4, f_cisdCell(ltfCISD, ltfFlipAt), text_color = f_glyphCol(ltfCISD), text_size = tSize, text_formatting = text.format_bold)
    table.cell(tbl, 2, 4, f_structTxt(ltfTrend, ltfChU, ltfChD, ltfBU, ltfBD), text_color = f_glyphCol(ltfTrend), text_size = tSize)
    if showQT
        table.cell(tbl, 3, 4, "6H " + f_qTxt(q6), text_color = mutedCol, text_size = tSize)

    // Market regime strip
    regimeCol = regimeText == "Trend" ? color.new(color.lime, 0) : regimeText == "Chop" ? color.new(#ffa726, 0) : mutedCol
    table.cell(tbl, 0, 5, "ATR " + str.tostring(atrVal, format.mintick) + "  ·  ADX " + str.tostring(adxVal, "#.#") + " " + regimeText, text_color = regimeCol, text_size = size.small, text_formatting = text.format_bold)

    // Orderflow / Delta strip
    if showDeltaRow
        cvdCol  = cvd > 0 ? color.new(color.lime, 0) : cvd < 0 ? color.new(color.red, 0) : mutedCol
        absTxt  = sinceBullAbs <= 3 ? "  ·  Abs▲" : sinceBearAbs <= 3 ? "  ·  Abs▼" : ""
        ofTxt   = "Δ " + (barDelta >= 0 ? "+" : "") + str.tostring(barDelta, format.volume) + "  ·  CVD " + (cvd >= 0 ? "+" : "") + str.tostring(cvd, format.volume) + absTxt
        table.cell(tbl, 0, rOF, ofTxt, text_color = cvdCol, text_size = size.small, text_formatting = text.format_bold)

    // Setup statistics strip (running backtest of current settings)
    if showStatsRow
        int statTotal = statWins + statLoss + statOther
        float avgR = statTotal > 0 ? statSumR / statTotal : na
        float winPct = statWins + statLoss > 0 ? 100.0 * statWins / (statWins + statLoss) : na
        statCol = na(avgR) ? mutedCol : avgR >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0)
        statTxt = statTotal == 0 ? "Setups: –" : "Setups " + str.tostring(statTotal) + "  ·  ✓" + str.tostring(statWins) + " ✗" + str.tostring(statLoss) + "  ·  Win " + (na(winPct) ? "–" : str.tostring(winPct, "#") + "%") + "  ·  Ø " + (avgR >= 0 ? "+" : "") + str.tostring(avgR, "#.##") + "R"
        table.cell(tbl, 0, rStat, statTxt, text_color = statCol, text_size = size.small, text_formatting = text.format_bold)

    // SL/TP + contracts strip
    sizeCol = contracts <= 0 ? color.new(color.red, 0) : regimeText == "Chop" ? color.new(#ffa726, 0) : color.new(color.lime, 0)
    microPV = pointValue / 10.0
    microQty = stopDist > 0 and microPV > 0 ? math.floor(riskMoney / (stopDist * microPV)) : 0
    sizeTxt = contracts <= 0 ? (microQty > 0 ? "0x → Micro ($" + str.tostring(microPV, "#.##") + "/Pkt): " + str.tostring(microQty) + "x" : "0x – Stop zu groß!") : str.tostring(contracts) + "x" + (rawContracts > maxContracts ? " (Cap)" : "")
    table.cell(tbl, 0, rSize, "SL " + str.tostring(stopDist, format.mintick) + "  ·  TP " + str.tostring(tpDist, format.mintick) + " (" + str.tostring(rrRatio, "#.#") + "R)  ·  " + sizeTxt, text_color = sizeCol, text_size = size.small, text_formatting = text.format_bold)

    // Account strip
    table.cell(tbl, 0, rAcc, "$" + str.tostring(accountSize, "#,###") + "  ·  " + str.tostring(riskPct, "#.##") + "% = $" + str.tostring(riskMoney, "#,###") + "  ·  $" + str.tostring(pointValue, "#.##") + "/Pkt", text_color = mutedCol, text_size = size.small)
