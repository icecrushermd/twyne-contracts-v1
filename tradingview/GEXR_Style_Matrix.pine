//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  GEXR-Style Matrix PRO — Zero-Config
//
//  Erkennt das Chart-Symbol selbst und stellt alles automatisch ein:
//
//   Chart (inkl. Micros/CFDs)      Referenz-Optionsmarkt   IV-Index
//   ES/MES · SPX/US500             SPY                     VIX1D / VIX
//   NQ/MNQ · NDX/NAS100/US100      QQQ                     VXN
//   RTY/M2K · RUT/US2000           IWM                     RVX
//   YM/MYM · DJI/US30              DIA                     VXD
//   GC/MGC · GLD                   GLD                     GVZ
//   SI/SIL · SLV                   SLV                     VXSLV
//   CL/MCL · USO                   USO                     OVX
//   BTC/MBT · BTC-Spot · IBIT      IBIT                    (Statistik)
//   ETH/MET · ETH-Spot · ETHA      ETHA                    (Statistik)
//   alles andere                   Chart selbst            (Statistik)
//
//  Level-Priorität: manuell (Fetcher) > CBOE-IV-Schätzung > Statistik.
//  Manuelle Level immer in Referenz-Preisen eintragen (SPY/QQQ/GLD/...),
//  die Umrechnung auf Futures macht der Indikator selbst.
//  Einzige Einstellungen: Panel, Ribbon, Signale, Panel-Position.
// ═══════════════════════════════════════════════════════════════════════════
indicator("GEXR-Style Matrix PRO", shorttitle="GEXR-Style", overlay=true,
     max_labels_count=200, max_lines_count=200, max_boxes_count=100)

// ─────────────────────────── Inputs ───────────────────────────
grpES = "Options-Level ES/MES/SPX (in SPY-Preisen · 0 = auto)"
esMaxPain = input.float(0.0, "ES Max Pain",       minval=0, group=grpES)
esGexFlip = input.float(0.0, "ES GEX Flip",       minval=0, group=grpES)
esCall    = input.float(0.0, "ES Call Wall",      minval=0, group=grpES)
esPut     = input.float(0.0, "ES Put Wall",       minval=0, group=grpES)
esVU      = input.float(0.0, "ES VU",             minval=0, group=grpES)
esVD      = input.float(0.0, "ES VD",             minval=0, group=grpES)
esAbs     = input.float(0.0, "ES Abs GEX Strike", minval=0, group=grpES)

grpNQ = "Options-Level NQ/MNQ/NDX (in QQQ-Preisen · 0 = auto)"
nqMaxPain = input.float(0.0, "NQ Max Pain",       minval=0, group=grpNQ)
nqGexFlip = input.float(0.0, "NQ GEX Flip",       minval=0, group=grpNQ)
nqCall    = input.float(0.0, "NQ Call Wall",      minval=0, group=grpNQ)
nqPut     = input.float(0.0, "NQ Put Wall",       minval=0, group=grpNQ)
nqVU      = input.float(0.0, "NQ VU",             minval=0, group=grpNQ)
nqVD      = input.float(0.0, "NQ VD",             minval=0, group=grpNQ)
nqAbs     = input.float(0.0, "NQ Abs GEX Strike", minval=0, group=grpNQ)

grpO = "Options-Level andere Symbole (Referenz-Preise · 0 = auto)"
inMaxPain = input.float(0.0, "Max Pain",         minval=0, group=grpO)
inGexFlip = input.float(0.0, "GEX Flip",         minval=0, group=grpO)
inPivot   = input.float(0.0, "Dealer Pivot",     minval=0, group=grpO)
inCall    = input.float(0.0, "Call Wall",        minval=0, group=grpO)
inPut     = input.float(0.0, "Put Wall",         minval=0, group=grpO)
inVU      = input.float(0.0, "VU (Vol Trigger oben)",  minval=0, group=grpO)
inVD      = input.float(0.0, "VD (Vol Trigger unten)", minval=0, group=grpO)
inAbsGex  = input.float(0.0, "Abs GEX Strike",   minval=0, group=grpO)

grpV = "Darstellung"
showPanel  = input.bool(true, "Matrix-Panel anzeigen", group=grpV)
showRibbon = input.bool(true, "Trend-Ribbon anzeigen", group=grpV)
useSignals = input.bool(true, "LONG/SHORT Signale anzeigen", group=grpV)
panelPos   = input.string("Oben rechts", "Panel-Position", options=["Oben rechts", "Unten rechts", "Oben links"], group=grpV)

// Feste Parameter (bewährte Standardwerte, bewusst keine Inputs)
LEN_ANCHOR = 200      // Flow-Anker (Statistik-Modus)
DERIV_FRAC = 0.25     // UDL/LDL-Abstand als Anteil GEX→Call
OR_MIN     = 15       // Opening-Range-Minuten
ATR_LEN    = 14
RSI_LEN    = 14
SIG_GAP    = 10       // Mindestabstand zwischen Signalen (Bars)

// ─────────────── Symbol-Erkennung (Profil-Datenbank) ───────────────
root = syminfo.root
tick = syminfo.ticker
typ  = syminfo.type

// Index-Futures + Cash/CFD-Varianten + die ETFs selbst
grpSP = root == "ES"  or root == "MES" or tick == "SPX" or tick == "US500" or tick == "SPX500" or tick == "SPX500USD" or tick == "SPY"
grpND = root == "NQ"  or root == "MNQ" or tick == "NDX" or tick == "NAS100" or tick == "US100" or tick == "USTEC" or tick == "QQQ"
grpRU = root == "RTY" or root == "M2K" or tick == "RUT" or tick == "US2000" or tick == "IWM"
grpDJ = root == "YM"  or root == "MYM" or tick == "DJI" or tick == "US30" or tick == "DJ30" or tick == "DIA"
// Rohstoffe (Futures + ETF)
grpAU = root == "GC" or root == "MGC" or tick == "GLD"
grpAG = root == "SI" or root == "SIL" or tick == "SLV"
grpCL = root == "CL" or root == "MCL" or tick == "USO"
// Krypto (CME-Futures, Spot, ETFs)
grpBT = root == "BTC" or root == "MBT" or tick == "IBIT" or (typ == "crypto" and str.contains(tick, "BTC"))
grpET = root == "ETH" or root == "MET" or tick == "ETHA" or (typ == "crypto" and str.contains(tick, "ETH") and not str.contains(tick, "BTC"))

// Braucht der Chart eine Umrechnung? (Chart ≠ Options-Referenzmarkt)
isEtfSelf = tick == "SPY" or tick == "QQQ" or tick == "IWM" or tick == "DIA" or tick == "GLD" or tick == "SLV" or tick == "USO" or tick == "IBIT" or tick == "ETHA"
hasProfile = grpSP or grpND or grpRU or grpDJ or grpAU or grpAG or grpCL or grpBT or grpET
needRef = hasProfile and not isEtfSelf

effRefSym = grpSP ? "AMEX:SPY" : grpND ? "NASDAQ:QQQ" : grpRU ? "AMEX:IWM" : grpDJ ? "AMEX:DIA" :
     grpAU ? "AMEX:GLD" : grpAG ? "AMEX:SLV" : grpCL ? "AMEX:USO" :
     grpBT ? "NASDAQ:IBIT" : grpET ? "NASDAQ:ETHA" : syminfo.tickerid
effVolSym = grpSP ? "CBOE:VIX1D" : grpND ? "CBOE:VXN" : grpRU ? "CBOE:RVX" : grpDJ ? "CBOE:VXD" :
     grpAU ? "CBOE:GVZ" : grpAG ? "CBOE:VXSLV" : grpCL ? "CBOE:OVX" : "CBOE:VIX"
effVol0Sym = grpSP ? "CBOE:VIX" : grpND ? "CBOE:VXN" : grpRU ? "CBOE:RVX" : grpDJ ? "CBOE:VXD" :
     grpAU ? "CBOE:GVZ" : grpAG ? "CBOE:VXSLV" : grpCL ? "CBOE:OVX" : "CBOE:VIX"
hasIvProfile = grpSP or grpND or grpRU or grpDJ or grpAU or grpAG or grpCL   // Krypto/Unbekannt → Statistik

profTx = grpSP ? "S&P (SPY·VIX)" : grpND ? "Nasdaq (QQQ·VXN)" : grpRU ? "Russell (IWM·RVX)" : grpDJ ? "Dow (DIA·VXD)" :
     grpAU ? "Gold (GLD·GVZ)" : grpAG ? "Silber (SLV·VXSLV)" : grpCL ? "Öl (USO·OVX)" :
     grpBT ? "Bitcoin (IBIT)" : grpET ? "Ether (ETHA)" : "Generisch (Statistik)"

// Manuelle Level: S&P- und Nasdaq-Charts haben eigene Eingabe-Blöcke
mMaxPain = grpSP ? esMaxPain : grpND ? nqMaxPain : inMaxPain
mGexFlip = grpSP ? esGexFlip : grpND ? nqGexFlip : inGexFlip
mCall    = grpSP ? esCall    : grpND ? nqCall    : inCall
mPut     = grpSP ? esPut     : grpND ? nqPut     : inPut
mVU      = grpSP ? esVU      : grpND ? nqVU      : inVU
mVD      = grpSP ? esVD      : grpND ? nqVD      : inVD
mAbsGex  = grpSP ? esAbs     : grpND ? nqAbs     : inAbsGex

// ─────────────────────── Basis-Daten ───────────────────────
f_fmt(_x) => str.tostring(_x, format.mintick)

src = hlc3
vol = nz(volume) > 0 ? volume : 1.0
atr = ta.atr(ATR_LEN)
rsi = ta.rsi(close, RSI_LEN)
[diP, diM, adxV] = ta.dmi(14, 14)

// Vortageswerte (kein Repaint: [1]-Werte mit lookahead_on)
htf = timeframe.isintraday ? "D" : "W"
[pdH, pdL, pdC] = request.security(syminfo.tickerid, htf, [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

// Referenz-Symbol: Vortagesschluss für die Umrechnung
refC    = request.security(effRefSym, "D", close[1],            lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
refSma5 = request.security(effRefSym, "D", ta.sma(close, 5)[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Session-Anker: US-Cash-Open (09:30 NY); Symbole ohne NY-Session → Tageswechsel
newSes = ta.change(time("D")) != 0
inRTH  = time(timeframe.period, "0930-1600", "America/New_York")
rthNew = not na(inRTH) and na(inRTH[1])
var bool rthSeen = false
if rthNew
    rthSeen := true
anchorNew = rthNew or (newSes and not rthSeen)

var float sesO = na
var float sesH = na
var float sesL = na
var int sesStart = na
if anchorNew or na(sesO)
    sesO := open
    sesH := high
    sesL := low
    sesStart := time
else
    sesH := math.max(sesH, high)
    sesL := math.min(sesL, low)

// Opening Range
var float orH = na
var float orL = na
if anchorNew or na(orH)
    orH := high
    orL := low
else if time - sesStart < OR_MIN * 60 * 1000
    orH := math.max(orH, high)
    orL := math.min(orL, low)

// ─────────────── CBOE-Optionsdaten (Vortagesschluss → heute fix) ───────────────
iv1  = request.security(effVolSym,  "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
iv0  = request.security(effVol0Sym, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
skew = request.security("CBOE:SKEW", "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pcc  = request.security("USI:PCC",   "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ivDay = nz(iv1, iv0)                       // annualisierte IV in %

// Umrechnung Chart ↔ Referenz-Optionsmarkt (Vortagesschluss-Verhältnis)
convOk = needRef and not na(refC) and refC > 0 and not na(pdC)
conv   = convOk ? pdC / refC : 1.0
basePx = convOk ? refC : hasProfile and not na(refC) and refC > 0 ? refC : pdC

useCboe = hasIvProfile and not na(ivDay) and not na(basePx)

// Strike-Raster (automatisch nach Preisniveau, wie US-Optionsketten)
autoStep = basePx < 25 ? 0.5 : basePx < 100 ? 1.0 : basePx < 500 ? 2.5 : basePx < 1000 ? 5.0 : 10.0
step = autoStep
f_strike(_p) => math.round(_p / step) * step

// Expected Move aus IV: P × IV/100 × √(t/252)
em1 = basePx * ivDay / 100 * math.sqrt(1.0 / 252.0)
em5 = basePx * nz(iv0, ivDay) / 100 * math.sqrt(5.0 / 252.0)

// SKEW → Asymmetrie (hoher SKEW = mehr OTM-Put-Nachfrage → Downside weiter)
skewF = math.min(math.max((nz(skew, 115) - 115) / 100, -0.15), 0.35)
// Put/Call-Ratio → Positionierungs-Bias (>1 = put-lastig)
posBias = nz(pcc, 1.0) - 1.0

upEM = em1 * (1 - 0.5 * skewF)
dnEM = em1 * (1 + skewF)

// Alle CBOE-Level im Referenz-Raum (werden bei der Zuordnung ×conv skaliert)
cboeGex  = f_strike(basePx - posBias * 0.5 * em1)
cboeCall = f_strike(basePx + upEM)
cboePut  = f_strike(basePx - dnEM)
cboeCall := math.max(cboeCall, cboeGex + step)
cboePut  := math.min(cboePut,  cboeGex - step)
cboeVU   = math.max(f_strike(basePx + math.max(em5, 2 * upEM)), cboeCall + step)
cboeVD   = math.min(f_strike(basePx - math.max(em5 * (1 + skewF), 2 * dnEM)), cboePut - step)
cboePain = f_strike(nz(refSma5, basePx))

// ─────────────── Statistik-Fallback (ohne Optionsdaten) ───────────────
flow  = math.sum(src * vol, LEN_ANCHOR) / math.sum(vol, LEN_ANCHOR)
sigma = ta.stdev(src, LEN_ANCHOR)

// ─────────────────────── Level-Matrix ───────────────────────
// Manuelle und CBOE-Level liegen im Referenz-Raum → ×conv auf den Chart;
// der Pivot ist Preisstruktur des Charts selbst und bleibt chart-nativ
f_lvl(_manual, _cboe, _stat) => _manual > 0 ? _manual * conv : useCboe ? _cboe * conv : _stat

gexL   = f_lvl(mGexFlip, cboeGex,  flow)
callL  = f_lvl(mCall,    cboeCall, flow + 2 * sigma)
putL   = f_lvl(mPut,     cboePut,  flow - 2 * sigma)
vuL    = f_lvl(mVU,      cboeVU,   flow + 3 * sigma)
vdL    = f_lvl(mVD,      cboeVD,   flow - 3 * sigma)
painL  = f_lvl(mMaxPain, cboePain, ta.sma(src, LEN_ANCHOR))
pivotL = inPivot > 0 ? inPivot * conv : math.round_to_mintick((pdH + pdL + pdC) / 3)

// Abgeleitete Level (interne Benchmarks wie UDL/LDL im Original)
udl = gexL + DERIV_FRAC * (callL - gexL)
ldl = gexL - DERIV_FRAC * (callL - gexL)

// ─────────────────────── Regime & Trend ───────────────────────
posGamma = close > gexL
abovePivot = close > pivotL

emaF = ta.ema(close, 8)
emaM = ta.ema(close, 21)
emaS = ta.ema(close, 50)
ribbonUp = emaF > emaM

atrPct = ta.percentrank(atr, 100)
volaTx   = atrPct > 70 ? "Loud" : atrPct < 30 ? "Quiet" : "Normal"
actionTx = math.abs(close - sesO) < atr * 2 ? "Hold" : close > sesO ? "Push Up" : "Push Down"

biasBull = posGamma and ribbonUp
biasBear = not posGamma and not ribbonUp
biasTx   = biasBull ? "Bullish" : biasBear ? "Bearish" : "Mixed"
aligned  = biasBull or biasBear
activeTx = adxV > 18 ? "Active" : "Idle"

// Session-Verlauf für die Scenario Engine
heldPivot  = sesL > pivotL
openAbvPiv = sesO > pivotL
openAbvGex = sesO > gexL

// ─────────────── Dealer Pressure Zones (DPZ) ───────────────
// Volumengewichteter Preis der Trades innerhalb des jeweiligen Korridors
var float upNum = 0.0
var float upDen = 0.0
var float dnNum = 0.0
var float dnDen = 0.0
if anchorNew
    upNum := 0.0
    upDen := 0.0
    dnNum := 0.0
    dnDen := 0.0
if src >= gexL and src <= vuL
    upNum += src * vol
    upDen += vol
if src <= gexL and src >= vdL
    dnNum += src * vol
    dnDen += vol
upperDPZ = upDen > 0 ? upNum / upDen : math.avg(gexL, vuL)
lowerDPZ = dnDen > 0 ? dnNum / dnDen : math.avg(gexL, vdL)
absGexL  = mAbsGex > 0 ? mAbsGex * conv : posGamma ? callL : putL
absGexTx = (mAbsGex > 0 ? (absGexL >= gexL ? "CALL" : "PUT") : posGamma ? "CALL" : "PUT") + " @ " + f_fmt(absGexL)

// ─────────────────────── Signale ───────────────────────
longRaw  = posGamma and ribbonUp and rsi > 50 and (ta.crossover(close, udl) or ta.crossover(close, gexL))
shortRaw = not posGamma and not ribbonUp and rsi < 50 and (ta.crossunder(close, ldl) or ta.crossunder(close, gexL))

var int lastSigBar = -1000000
canSignal = bar_index - lastSigBar >= SIG_GAP
longSig  = useSignals and canSignal and longRaw
shortSig = useSignals and canSignal and shortRaw and not longSig
if longSig or shortSig
    lastSigBar := bar_index

// ─────────────────────── Plots ───────────────────────
pRibF = plot(showRibbon ? emaF : na, "Ribbon schnell", color=color.new(ribbonUp ? color.green : color.red, 60))
pRibM = plot(showRibbon ? emaM : na, "Ribbon langsam", color=color.new(ribbonUp ? color.green : color.red, 75))
fill(pRibF, pRibM, color=color.new(ribbonUp ? color.green : color.red, 85), title="Trend-Ribbon")

plot(gexL,  "GEX Flip",  color=color.new(color.orange, 100), display=display.status_line)
plot(callL, "Call Wall", color=color.new(color.teal, 100),   display=display.status_line)
plot(putL,  "Put Wall",  color=color.new(color.maroon, 100), display=display.status_line)

plotshape(longSig,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), text="LONG",  textcolor=color.white, size=size.small)
plotshape(shortSig, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0),   text="SHORT", textcolor=color.white, size=size.small)

// ─────────────── Level-Linien & Beschriftungen ───────────────
var line[]  lvlLines  = array.new_line()
var label[] lvlLabels = array.new_label()

f_level(float _y, string _name, color _col, bool _dashed) =>
    if not na(_y)
        array.push(lvlLines, line.new(bar_index - 1, _y, bar_index, _y, extend=extend.both,
             color=color.new(_col, 25), style=_dashed ? line.style_dashed : line.style_solid))
        array.push(lvlLabels, label.new(bar_index + 3, _y, _name + " " + f_fmt(_y),
             style=label.style_label_left, color=color.new(_col, 15), textcolor=color.white, size=size.small))

if barstate.islast
    for ln in lvlLines
        line.delete(ln)
    for lb in lvlLabels
        label.delete(lb)
    array.clear(lvlLines)
    array.clear(lvlLabels)
    f_level(painL,  "PAIN",  color.gray,    true)
    f_level(vuL,    "VU",    color.teal,    true)
    f_level(callL,  "CALL",  color.teal,    false)
    f_level(udl,    "UDL",   color.olive,   false)
    f_level(gexL,   "GEX",   color.orange,  false)
    f_level(ldl,    "LDL",   color.olive,   false)
    f_level(pivotL, "PIVOT", color.yellow,  false)
    f_level(putL,   "PUT",   color.maroon,  false)
    f_level(vdL,    "VD",    color.maroon,  true)
    if timeframe.isintraday
        f_level(orH, "ORZ H", color.silver, true)
        f_level(orL, "ORZ L", color.silver, true)

// ─────────────────── Scenario Engine (Texte) ───────────────────
txtOpen = switch
    openAbvPiv and openAbvGex         => "Opened above Pivot (" + f_fmt(pivotL) + ")\nand GEX Flip (" + f_fmt(gexL) + ").\nBulls started with the regime."
    not openAbvPiv and not openAbvGex => "Opened below Pivot (" + f_fmt(pivotL) + ")\nand GEX Flip (" + f_fmt(gexL) + ").\nBears started with the regime."
    => "Opened between Pivot (" + f_fmt(pivotL) + ")\nand GEX Flip (" + f_fmt(gexL) + ").\nRegime undecided at the open."

txtAction = switch
    posGamma and heldPivot => "Held Pivot (" + f_fmt(pivotL) + ")\nand cleared GEX Flip (" + f_fmt(gexL) + ").\nPositive gamma regime intact."
    posGamma               => "Reclaimed GEX Flip (" + f_fmt(gexL) + ")\nafter testing Pivot.\nRegime repaired."
    abovePivot             => "Holding Pivot (" + f_fmt(pivotL) + ")\nbut below GEX Flip (" + f_fmt(gexL) + ").\nRegime contested."
    => "Lost Pivot (" + f_fmt(pivotL) + ").\nBears control the tape."

txtRead = switch
    posGamma and abovePivot => "Above Pivot and GEX Flip.\nPositive gamma — dealers stabilizing.\nBulls own structure.\nUDL (" + f_fmt(udl) + ") is internal benchmark."
    abovePivot              => "Above Pivot, below GEX Flip.\nNegative gamma pocket — moves extend.\nLDL (" + f_fmt(ldl) + ") guides risk."
    => "Below Pivot.\nNegative gamma — dealers amplify moves.\nLDL (" + f_fmt(ldl) + ") / Put Wall (" + f_fmt(putL) + ") in play."

txtSeq = posGamma ?
     "Positive gamma holds above GEX Flip.\nPath: UDL (" + f_fmt(udl) + ") → Call Wall (" + f_fmt(callL) + ").\nClear that → VU (" + f_fmt(vuL) + ") opens." :
     "Negative gamma below GEX Flip.\nPath: LDL (" + f_fmt(ldl) + ") → Put Wall (" + f_fmt(putL) + ").\nLose that → VD (" + f_fmt(vdL) + ") opens."

txtNext = posGamma ?
     (close < udl ? "UDL @ " + f_fmt(udl) + " → Call @ " + f_fmt(callL) :
      close < callL ? "Call @ " + f_fmt(callL) + " → VU @ " + f_fmt(vuL) :
      "VU @ " + f_fmt(vuL) + " (Korridor-Rand)") :
     (close > ldl ? "LDL @ " + f_fmt(ldl) + " → Put @ " + f_fmt(putL) :
      close > putL ? "Put @ " + f_fmt(putL) + " → VD @ " + f_fmt(vdL) :
      "VD @ " + f_fmt(vdL) + " (Korridor-Rand)")

txtFlip = posGamma ?
     "Lose GEX Flip (" + f_fmt(gexL) + ") on close → gamma weakens.\nLose Pivot (" + f_fmt(pivotL) + ") → structure turns bearish fast." :
     "Reclaim GEX Flip (" + f_fmt(gexL) + ") → gamma stabilizes.\nReclaim Pivot (" + f_fmt(pivotL) + ") first."

chk(_b) => _b ? "✓" : "✗"
txtLevels = "PV " + chk(abovePivot) + "  GX " + chk(posGamma) + "  PUT " + chk(close > putL) + "  CALL " + chk(close > callL)
modeTx = (adxV > 25 ? "Trending" : "Balanced") + " · ATR " + (volaTx == "Loud" ? "Expanded" : volaTx == "Quiet" ? "Compressed" : "Balanced")
srcTx = useCboe ?
     "IV " + str.tostring(ivDay, "0.0") + " · EM ±" + f_fmt(em1) + " · SKEW " + str.tostring(nz(skew, 0), "0") + " · P/C " + str.tostring(nz(pcc, 1), "0.00") +
     (convOk ? "\nRef-Umrechnung ×" + str.tostring(conv, "0.0000") : "") :
     "Statistik-Modus" + (convOk ? " · Ref ×" + str.tostring(conv, "0.0000") : "")

// ─────────────────────── Matrix-Panel ───────────────────────
cBull  = color.new(#2ecc71, 0)
cBear  = color.new(#ff5252, 0)
cAmber = color.new(#f0b429, 0)
cText  = color.new(#d8dee9, 0)
cKey   = color.new(#8a919e, 0)
cBg    = color.new(#0b0e14, 15)
cHead  = color.new(#151a24, 0)

f_head(table _t, int _row, string _txt) =>
    table.cell(_t, 0, _row, _txt, text_color=cAmber, text_size=size.tiny, text_halign=text.align_left, bgcolor=cHead)
    table.cell(_t, 1, _row, "",   bgcolor=cHead)

f_row(table _t, int _row, string _k, string _v, color _vc) =>
    table.cell(_t, 0, _row, _k, text_color=cKey, text_size=size.tiny, text_halign=text.align_left)
    table.cell(_t, 1, _row, _v, text_color=_vc, text_size=size.tiny, text_halign=text.align_left)

if showPanel and barstate.islast
    pos = panelPos == "Unten rechts" ? position.bottom_right : panelPos == "Oben links" ? position.top_left : position.top_right
    var table t = table.new(pos, 2, 28, bgcolor=cBg, border_width=1, border_color=color.new(color.gray, 75))
    cBias = biasBull ? cBull : biasBear ? cBear : cAmber
    table.cell(t, 0, 0, "GEXR-Style Matrix  " + syminfo.ticker, text_color=cText, text_size=size.small, text_halign=text.align_left, bgcolor=cHead)
    table.cell(t, 1, 0, biasTx, text_color=cBias, text_size=size.small, text_halign=text.align_right, bgcolor=cHead)
    f_head(t, 1, "◦ FLOW")
    f_row(t, 2, "Profil:",    profTx, cText)
    f_row(t, 3, "Pressure:",  "Max Pain @ " + f_fmt(painL), cAmber)
    f_row(t, 4, "Break:",     "Dealer Pivot @ " + f_fmt(pivotL), cText)
    f_row(t, 5, "Corridor:",  "VD ↔ VU  |  " + f_fmt(vdL) + " – " + f_fmt(vuL), cText)
    f_row(t, 6, "Options:",   srcTx, useCboe ? cText : cAmber)
    f_row(t, 7, "ATR Story:", (ribbonUp ? "Bullish" : "Bearish") + " · " + volaTx + " · " + actionTx, ribbonUp ? cBull : cBear)
    f_row(t, 8, "Alignment:", (aligned ? "Aligned" : "Mixed") + " · " + activeTx, aligned ? cBull : cAmber)
    f_head(t, 9, "◦ SCENARIO ENGINE")
    f_row(t, 10, "Open:",   txtOpen, cText)
    f_row(t, 11, "Action:", txtAction, cText)
    f_row(t, 12, "Read:",   txtRead, posGamma ? cBull : cBear)
    f_head(t, 13, "◦ THE PATH")
    f_row(t, 14, "Bias:",     biasTx + " · " + activeTx, cBias)
    f_row(t, 15, "Sequence:", txtSeq, posGamma ? cBull : cBear)
    f_row(t, 16, "Next:",     txtNext, cText)
    f_head(t, 17, "◦ THE TURN")
    f_row(t, 18, "Flip If:", txtFlip, cAmber)
    f_head(t, 19, "◦ LIVE STATUS")
    f_row(t, 20, "Levels:",      txtLevels, cText)
    f_row(t, 21, "Pivot / GEX:", f_fmt(pivotL) + "  /  " + f_fmt(gexL), cText)
    f_row(t, 22, "Put / VD:",    f_fmt(putL) + "  /  " + f_fmt(vdL), cText)
    f_row(t, 23, "Mode:",        modeTx, cText)
    f_head(t, 24, "◦ DEALER")
    f_row(t, 25, "Upper DPZ:", "▲ " + f_fmt(upperDPZ) + "  [" + f_fmt(gexL) + " – " + f_fmt(vuL) + "]", cBull)
    f_row(t, 26, "Lower DPZ:", "▼ " + f_fmt(lowerDPZ) + "  [" + f_fmt(vdL) + " – " + f_fmt(gexL) + "]", cBear)
    f_row(t, 27, "Abs GEX:",   absGexTx, cAmber)

// ─────────────────────── Alerts ───────────────────────
gexUp   = ta.crossover(close, gexL)
gexDn   = ta.crossunder(close, gexL)
pivUp   = ta.crossover(close, pivotL)
pivDn   = ta.crossunder(close, pivotL)
callHit = ta.crossover(high, callL)
putHit  = ta.crossunder(low, putL)

alertcondition(longSig,  "GEXR Long-Setup",      "GEXR-Style: LONG — Struktur + Gamma-Regime + Trend im Einklang")
alertcondition(shortSig, "GEXR Short-Setup",     "GEXR-Style: SHORT — Struktur + Gamma-Regime + Trend im Einklang")
alertcondition(gexUp,    "GEX Flip zurückerobert", "GEXR-Style: Schluss über GEX Flip — positives Gamma-Regime")
alertcondition(gexDn,    "GEX Flip verloren",      "GEXR-Style: Schluss unter GEX Flip — Gamma-Regime schwächt sich ab")
alertcondition(pivUp,    "Dealer Pivot zurückerobert", "GEXR-Style: Schluss über Dealer Pivot")
alertcondition(pivDn,    "Dealer Pivot verloren",      "GEXR-Style: Schluss unter Dealer Pivot — Struktur kippt bärisch")
alertcondition(callHit,  "Call Wall erreicht", "GEXR-Style: Call Wall getestet — Widerstandszone")
alertcondition(putHit,   "Put Wall erreicht",  "GEXR-Style: Put Wall getestet — Supportzone")
