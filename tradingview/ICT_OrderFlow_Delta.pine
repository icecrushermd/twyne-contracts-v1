// ICT Order Flow Delta — separates Pane-Indikator
// Normiertes Delta-Histogramm: Kaufdruck-% pro Bar (−100 … +100)
// Sofort lesbar ohne Skalierungsprobleme zwischen Bar-Delta und kum. Delta.

//@version=6
indicator("ICT Order Flow Delta", shorttitle="ICT OFD", overlay=false)

// ─── INPUTS ──────────────────────────────────────────────────────────────────

grp_delta  = "Delta Einstellungen"
dom_len    = input.int(20, "Dominanz Lookback (Kerzen)", minval=3, group=grp_delta)
smooth_len = input.int(5,  "Glättung EMA (Kerzen)",      minval=1, group=grp_delta)

grp_vis    = "Darstellung"
show_hist  = input.bool(true,  "Bar-Delta Histogramm (normiert)", group=grp_vis)
show_ema   = input.bool(true,  "Geglättete Delta-Linie",          group=grp_vis)
show_dom   = input.bool(true,  "Rollende Dominanz-Linie",         group=grp_vis)
show_bg    = input.bool(true,  "Hintergrundfarbe bei Dominanz",    group=grp_vis)
bull_th    = input.int(60,     "Bull-Schwelle (%)",  minval=51, maxval=99, group=grp_vis)
bear_th    = input.int(40,     "Bear-Schwelle (%)",  minval=1,  maxval=49, group=grp_vis)

COL_BUY  = color.new(#00C853, 0)
COL_SELL = color.new(#D50000, 0)
COL_NEUT = color.new(#607D8B, 0)

// ─── DELTA BERECHNUNG ────────────────────────────────────────────────────────
// buy_pct: 0–100 — wie viel % des Volumens war Kaufdruck
// Kerze schließt oben in der Range → ~100 % Kauf, unten → ~0 %

buy_vol  = high != low ? volume * (close - low) / (high - low) : volume * 0.5
buy_pct  = volume > 0 ? buy_vol / volume * 100.0 : 50.0   // 0–100 %
delta_n  = buy_pct - 50.0                                  // normiert: −50 … +50

// Rollende Dominanz: Ø buy_pct über dom_len Bars (0–100 %)
dom_avg  = ta.sma(buy_pct, dom_len)                        // 0–100 %
dom_line = dom_avg - 50.0                                  // −50 … +50 für Darstellung

// Geglätteter Bar-Delta
smooth_d = ta.ema(delta_n, smooth_len)

// ─── REFERENZLINIEN ──────────────────────────────────────────────────────────

hline(0,               "Gleichgewicht",  color=color.new(#607D8B, 40), linewidth=1)
hline( bull_th - 50,   "Bull-Schwelle",  color=color.new(#00C853, 50), linestyle=hline.style_dashed)
hline(-(50 - bear_th), "Bear-Schwelle",  color=color.new(#D50000, 50), linestyle=hline.style_dashed)
hline( 50,             "+50 Max",        color=color.new(#607D8B, 80), linestyle=hline.style_dotted)
hline(-50,             "−50 Min",        color=color.new(#607D8B, 80), linestyle=hline.style_dotted)

// ─── HINTERGRUND ─────────────────────────────────────────────────────────────

bgcolor(show_bg and dom_avg >= bull_th ? color.new(COL_BUY,  92) :
        show_bg and dom_avg <= bear_th ? color.new(COL_SELL, 92) : na,
        title="Dominanz Hintergrund")

// ─── BAR-DELTA HISTOGRAMM ─────────────────────────────────────────────────────
// Grün = mehr Käufer als Verkäufer, Rot = umgekehrt
// Sättigung steigt mit Stärke (hell = schwach, dunkel = stark)

bar_col = delta_n >= 0 ? color.new(COL_BUY,  math.max(0, 80 - math.abs(delta_n) * 1.2)) : color.new(COL_SELL, math.max(0, 80 - math.abs(delta_n) * 1.2))

plot(show_hist ? delta_n : na, "Bar Delta %",
     color=bar_col, style=plot.style_columns, linewidth=1)

// ─── GEGLÄTTETE DELTA-LINIE ──────────────────────────────────────────────────

plot(show_ema ? smooth_d : na, "Delta EMA",
     color=smooth_d >= 0 ? COL_BUY : COL_SELL,
     linewidth=2)

// ─── ROLLENDE DOMINANZ-LINIE ─────────────────────────────────────────────────

dom_col = dom_avg >= bull_th ? COL_BUY : dom_avg <= bear_th ? COL_SELL : COL_NEUT

plot(show_dom ? dom_line : na, "Dominanz Ø",
     color=dom_col, linewidth=2, style=plot.style_line)

// ─── INFO-TABELLE (fixe Ecke, kein Overlap) ──────────────────────────────────

var table info_tbl = table.new(position.top_right, 1, 1,
     bgcolor=color.new(#1E1E2E, 70), border_width=1,
     border_color=color.new(#444466, 60))

if barstate.islast
    pct_str  = str.tostring(math.round(dom_avg, 1)) + "%"
    lbl      = dom_avg >= bull_th ? "▲ Käufer " + pct_str : dom_avg <= bear_th ? "▼ Verkäufer " + pct_str : "● Neutral " + pct_str
    table.cell(info_tbl, 0, 0, lbl, text_color=dom_col, text_size=size.small)
