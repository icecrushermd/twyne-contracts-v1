// This source code is subject to the terms of the Mozilla Public License 2.0
// ICT Timeframe Alignment + Dynamic Stop Indicator
// Shows trend direction across multiple timeframes and suggests stop placement
// based on the last confirmed swing structure (ICT methodology)

//@version=6
indicator("ICT TFA + Dynamic Stop", shorttitle="ICT TFA+SL", overlay=true)

// ─── INPUTS ──────────────────────────────────────────────────────────────────

grp_method  = "Trend Method"
method      = input.string("BOS / CHoCH", "Trend Detection", options=["EMA","BOS / CHoCH"], group=grp_method)
ema_fast    = input.int(20,  "Fast EMA",  minval=1, group=grp_method)
ema_slow    = input.int(50,  "Slow EMA",  minval=1, group=grp_method)

grp_stop    = "Dynamic Stop"
piv_left    = input.int(5, "Pivot Left Bars",  options=[3, 5], group=grp_stop)
piv_right   = input.int(5, "Pivot Right Bars", options=[3, 5], group=grp_stop)
atr_len     = input.int(14,    "ATR Length",   minval=1,             group=grp_stop)
atr_buf     = input.float(0.5, "ATR Buffer",   minval=0.0, step=0.1, group=grp_stop,
              tooltip="Extra distance below/above pivot in ATR units")
show_stop   = input.bool(true, "Show Stop Line",      group=grp_stop)
show_swings = input.bool(true, "Show Swing Markers",  group=grp_stop)
show_bos    = input.bool(true, "BOS / CHoCH Labels",  group=grp_stop,
              tooltip="BOS = Trendfortsetzung, CHoCH = erstes gegenteiliges Signal (Change of Character)")

grp_tf      = "Timeframes"
show_m      = input.bool(true,  "Monthly",    group=grp_tf)
show_w      = input.bool(true,  "Weekly",     group=grp_tf)
show_d      = input.bool(true,  "Daily",      group=grp_tf)
show_4h     = input.bool(true,  "4H",         group=grp_tf)
show_1h     = input.bool(true,  "1H",         group=grp_tf)
show_15     = input.bool(true,  "15m",        group=grp_tf)
show_cur    = input.bool(true,  "Current TF", group=grp_tf)

grp_vis     = "Display"
tbl_pos     = input.string("Top Right", "Table Position",
              options=["Top Right","Top Left","Bottom Right","Bottom Left","Top Center","Bottom Center"],
              group=grp_vis)

grp_lvl     = "Intraday Kerzen-Levels"

show_t1     = input.bool(true,   "Zeit 1 aktiv",           group=grp_lvl)
hour_t1     = input.int(8,       "Zeit 1 — Stunde (NY)",   minval=0, maxval=23, group=grp_lvl)
min_t1      = input.int(30,      "Zeit 1 — Minute",        minval=0, maxval=59, group=grp_lvl)
col_t1      = input.color(color.new(#FF9800, 0), "Zeit 1 — Farbe", group=grp_lvl)
lbl_t1      = input.string("08:30 News", "Zeit 1 — Label", group=grp_lvl)

show_t2     = input.bool(true,   "Zeit 2 aktiv",           group=grp_lvl)
hour_t2     = input.int(9,       "Zeit 2 — Stunde (NY)",   minval=0, maxval=23, group=grp_lvl)
min_t2      = input.int(29,      "Zeit 2 — Minute",        minval=0, maxval=59, group=grp_lvl)
col_t2      = input.color(color.new(#2196F3, 0), "Zeit 2 — Farbe", group=grp_lvl)
lbl_t2      = input.string("09:29 Pre-Open", "Zeit 2 — Label", group=grp_lvl)

show_t3     = input.bool(false,  "Zeit 3 aktiv",           group=grp_lvl)
hour_t3     = input.int(10,      "Zeit 3 — Stunde (NY)",   minval=0, maxval=23, group=grp_lvl)
min_t3      = input.int(0,       "Zeit 3 — Minute",        minval=0, maxval=59, group=grp_lvl)
col_t3      = input.color(color.new(#9C27B0, 0), "Zeit 3 — Farbe", group=grp_lvl)
lbl_t3      = input.string("10:00 Custom", "Zeit 3 — Label", group=grp_lvl)

grp_flow    = "Order Flow / Projektion"
show_mm     = input.bool(true,  "Measured Move Ziel",          group=grp_flow,
              tooltip="Projiziert die letzte Swing-Range vorwärts als nächstes Kursziel")
show_eqhl   = input.bool(true,  "Equal Highs / Equal Lows",    group=grp_flow,
              tooltip="Markiert Liquiditätspools — Bereiche wo Stops clustern und Kurs hinläuft")
dom_len     = input.int(20,   "Dominanz Lookback (Kerzen)",    minval=5, group=grp_flow)
eq_thresh   = input.float(0.1,"Equal H/L Toleranz %",          minval=0.01, step=0.01, group=grp_flow)
eq_lookback = input.int(30,   "Equal H/L Lookback (Kerzen)",   minval=10,  group=grp_flow)
col_mm      = input.color(color.new(#E040FB, 0), "MM Ziel Farbe",    group=grp_flow)
col_eq      = input.color(color.new(#FFD600, 0), "Equal H/L Farbe",  group=grp_flow)

// ─── COLOURS ─────────────────────────────────────────────────────────────────

COL_BULL   = color.new(#00C853, 0)
COL_BEAR   = color.new(#D50000, 0)
COL_NEUT   = color.new(#607D8B, 0)
COL_STOP   = color.new(#FF6F00, 0)
COL_BG     = color.new(#1E1E2E, 90)
COL_HEADER = color.new(#2A2A3E, 80)
COL_TEXT   = color.new(#E0E0E0, 0)
COL_CTX    = color.new(#E65100, 60)   // context TF highlight (deep orange)
COL_ENT    = color.new(#006064, 60)   // entry TF highlight (teal)

// ─── TREND LOGIC ─────────────────────────────────────────────────────────────

f_trend_ema(fast, slow) =>
    f = ta.ema(close, fast)
    s = ta.ema(close, slow)
    f > s ? 1 : f < s ? -1 : 0

// BOS / CHoCH structure tracking.
// A confirmed pivot high broken by a close above → Bullish BOS → trend = 1.
// A confirmed pivot low  broken by a close below → Bearish BOS → trend = -1.
// Broken reference cleared so the same level cannot re-trigger.
f_trend_bos(piv_l, piv_r) =>
    ph = ta.pivothigh(high, piv_l, piv_r)
    pl = ta.pivotlow(low,   piv_l, piv_r)
    var float ref_h     = na
    var float ref_l     = na
    var int   bos_trend = 0
    if not na(ph)
        ref_h := ph
    if not na(pl)
        ref_l := pl
    if not na(ref_h) and close > ref_h
        bos_trend := 1
        ref_h     := na
    else if not na(ref_l) and close < ref_l
        bos_trend := -1
        ref_l     := na
    bos_trend

f_trend() =>
    method == "EMA" ? f_trend_ema(ema_fast, ema_slow) : f_trend_bos(piv_left, piv_right)

// ─── MULTI-TF REQUESTS ───────────────────────────────────────────────────────

trend_cur = f_trend()
trend_m   = request.security(syminfo.tickerid, "M",   f_trend(), lookahead=barmerge.lookahead_off)
trend_w   = request.security(syminfo.tickerid, "W",   f_trend(), lookahead=barmerge.lookahead_off)
trend_d   = request.security(syminfo.tickerid, "D",   f_trend(), lookahead=barmerge.lookahead_off)
trend_4h  = request.security(syminfo.tickerid, "240", f_trend(), lookahead=barmerge.lookahead_off)
trend_1h  = request.security(syminfo.tickerid, "60",  f_trend(), lookahead=barmerge.lookahead_off)
trend_15  = request.security(syminfo.tickerid, "15",  f_trend(), lookahead=barmerge.lookahead_off)

f_1m_body(h, m) =>
    match = hour(time, "America/New_York") == h and minute(time, "America/New_York") == m
    [match ? math.max(open, close) : float(na),
     match ? math.min(open, close) : float(na)]

[raw_top_t1, raw_bot_t1] = request.security(syminfo.tickerid, "1", f_1m_body(hour_t1, min_t1), lookahead=barmerge.lookahead_on)
[raw_top_t2, raw_bot_t2] = request.security(syminfo.tickerid, "1", f_1m_body(hour_t2, min_t2), lookahead=barmerge.lookahead_on)
[raw_top_t3, raw_bot_t3] = request.security(syminfo.tickerid, "1", f_1m_body(hour_t3, min_t3), lookahead=barmerge.lookahead_on)

// ─── ALIGNMENT SCORE ─────────────────────────────────────────────────────────

active_count = (show_m ? 1 : 0) + (show_w ? 1 : 0) + (show_d ? 1 : 0) + (show_4h ? 1 : 0) + (show_1h ? 1 : 0) + (show_15 ? 1 : 0) + (show_cur ? 1 : 0)

bull_count = (show_m and trend_m == 1 ? 1 : 0) + (show_w and trend_w == 1 ? 1 : 0) + (show_d and trend_d == 1 ? 1 : 0) + (show_4h and trend_4h == 1 ? 1 : 0) + (show_1h and trend_1h == 1 ? 1 : 0) + (show_15 and trend_15 == 1 ? 1 : 0) + (show_cur and trend_cur == 1 ? 1 : 0)

alignment_pct = active_count > 0 ? (bull_count / active_count) * 100.0 : 50.0

// ─── ORDER FLOW / KÄUFER-VERKÄUFER DOMINANZ ──────────────────────────────────

buy_vol  = high != low ? volume * (close - low) / (high - low) : volume * 0.5
sell_vol = volume - buy_vol
delta    = buy_vol - sell_vol

delta_sum = math.sum(delta, dom_len)
vol_sum   = math.sum(volume, dom_len)
dom_pct   = vol_sum > 0 ? delta_sum / vol_sum * 100.0 : 0.0

dom_str = dom_pct > 20.0 ? "▲ Käufer  +" + str.tostring(math.round(dom_pct)) + "%" : dom_pct < -20.0 ? "▼ Verkäufer " + str.tostring(math.round(dom_pct)) + "%" : "● Ausgeglichen"
dom_col = dom_pct >  20.0 ? COL_BULL : dom_pct < -20.0 ? COL_BEAR : COL_NEUT

// ─── EQUAL HIGHS / EQUAL LOWS (Liquiditätspools) ─────────────────────────────

tol         = eq_thresh / 100.0
recent_high = ta.highest(high[1], eq_lookback)
recent_low  = ta.lowest(low[1],   eq_lookback)

is_eq_high = show_eqhl and recent_high > 0 and math.abs(high - recent_high) / recent_high < tol
is_eq_low  = show_eqhl and recent_low  > 0 and math.abs(low  - recent_low)  / recent_low  < tol

// ─── PIVOT / SWING DETECTION ─────────────────────────────────────────────────

atr_val = ta.atr(atr_len)

swH = ta.pivothigh(high, piv_left, piv_right)
swL = ta.pivotlow(low,   piv_left, piv_right)

var float last_swH = na
var float last_swL = na

if not na(swH)
    last_swH := swH
if not na(swL)
    last_swL := swL

// ─── BOS / CHoCH LABELS (current TF only) ────────────────────────────────────

var float bos_ref_h    = na
var float bos_ref_l    = na
var int   bos_cur_trnd = 0

if not na(swH)
    bos_ref_h := swH
if not na(swL)
    bos_ref_l := swL

if not na(bos_ref_h) and close > bos_ref_h
    if show_bos and method == "BOS / CHoCH" and barstate.isconfirmed
        lbl_txt = bos_cur_trnd == -1 ? "CHoCH ▲" : "BOS ▲"
        lbl_col = bos_cur_trnd == -1 ? color.new(#00E5FF, 0) : COL_BULL
        label.new(bar_index, low, lbl_txt, color=color.new(lbl_col, 75), textcolor=lbl_col, style=label.style_label_up, size=size.tiny)
    bos_cur_trnd := 1
    bos_ref_h    := na

else if not na(bos_ref_l) and close < bos_ref_l
    if show_bos and method == "BOS / CHoCH" and barstate.isconfirmed
        lbl_txt = bos_cur_trnd == 1 ? "CHoCH ▼" : "BOS ▼"
        lbl_col = bos_cur_trnd == 1 ? color.new(#FF6F00, 0) : COL_BEAR
        label.new(bar_index, high, lbl_txt, color=color.new(lbl_col, 75), textcolor=lbl_col, style=label.style_label_down, size=size.tiny)
    bos_cur_trnd := -1
    bos_ref_l    := na

// ─── TIMEFRAME PAIRING ───────────────────────────────────────────────────────
// Maps the current chart TF to the ICT context/entry pairing:
//   Context (HTF) = the TF that defines the bias you trade with
//   Entry   (LTF) = the TF on which you time the actual trade
// Rows in the trend table are highlighted accordingly:
//   orange = context TF   teal = entry TF

_ctx_key  = switch timeframe.period
    "1"   => "15"
    "3"   => "15"
    "5"   => "60"
    "15"  => "240"
    "30"  => "240"
    "60"  => "D"
    "120" => "D"
    "240" => "W"
    "D"   => "W"
    "W"   => "M"
    => ""

_ctx_lbl  = switch timeframe.period
    "1"   => "15m"
    "3"   => "15m"
    "5"   => "1H"
    "15"  => "4H"
    "30"  => "4H"
    "60"  => "Daily"
    "120" => "Daily"
    "240" => "Weekly"
    "D"   => "Weekly"
    "W"   => "Monthly"
    => "—"

_ent2_key = switch timeframe.period
    "3"   => "1"
    "5"   => "1"
    "15"  => "5"
    "30"  => "15"
    "60"  => "15"
    "120" => "60"
    "240" => "60"
    "D"   => "240"
    "W"   => "D"
    => ""

_ent_lbl  = switch timeframe.period
    "1"   => "1m"
    "3"   => "3m / 1m"
    "5"   => "5m / 1m"
    "15"  => "15m / 5m"
    "30"  => "30m / 15m"
    "60"  => "1H / 15m"
    "120" => "2H / 1H"
    "240" => "4H / 1H"
    "D"   => "Daily / 4H"
    "W"   => "Weekly / Daily"
    => timeframe.period

_style_lbl = switch timeframe.period
    "1"   => "Scalping"
    "3"   => "Scalping"
    "5"   => "Intraday / Scalping"
    "15"  => "Day Trading"
    "30"  => "Day Trading"
    "60"  => "Day Trading"
    "120" => "Day Trading"
    "240" => "Position / Swing"
    "D"   => "Swing Trading"
    "W"   => "Swing / Position"
    => "—"

_ctx_trend = _ctx_key == "M" ? trend_m : _ctx_key == "W" ? trend_w : _ctx_key == "D" ? trend_d : _ctx_key == "240" ? trend_4h : _ctx_key == "60" ? trend_1h : _ctx_key == "15" ? trend_15 : trend_cur

// Returns label-cell bg for a given TF key (context = orange, entry = teal)
f_lbl_bg(k) =>
    k == _ctx_key ? COL_CTX : (k == timeframe.period or (_ent2_key != "" and k == _ent2_key)) ? COL_ENT : COL_HEADER

// Returns value-cell bg for a given TF key
f_val_bg(k) =>
    k == _ctx_key ? COL_CTX : (k == timeframe.period or (_ent2_key != "" and k == _ent2_key)) ? COL_ENT : COL_BG

// ─── DYNAMIC STOP LEVEL ──────────────────────────────────────────────────────

htf_bias = trend_d != 0 ? trend_d : trend_w != 0 ? trend_w : trend_cur

stop_level = float(na)
if htf_bias == 1 and not na(last_swL)
    stop_level := last_swL - atr_buf * atr_val
else if htf_bias == -1 and not na(last_swH)
    stop_level := last_swH + atr_buf * atr_val

stop_dist_pct = not na(stop_level) ? math.abs(close - stop_level) / close * 100.0 : float(na)
stop_dist_atr = not na(stop_level) ? math.abs(close - stop_level) / atr_val        : float(na)

// ─── MEASURED MOVE PROJEKTION ─────────────────────────────────────────────────

swing_range = not na(last_swH) and not na(last_swL) ? last_swH - last_swL : float(na)

mm_target = float(na)
if show_mm and not na(swing_range)
    if htf_bias == 1
        mm_target := last_swH + swing_range
    else if htf_bias == -1
        mm_target := last_swL - swing_range

mm_dist_pct = not na(mm_target) ? math.abs(mm_target - close) / close * 100.0 : float(na)
mm_dist_atr = not na(mm_target) ? math.abs(mm_target - close) / atr_val        : float(na)

// ─── CHART VISUALS ───────────────────────────────────────────────────────────

plot(show_stop ? stop_level : na, "Dynamic Stop",
     color=COL_STOP, linewidth=1, style=plot.style_linebr)

plotshape(show_swings and not na(swH), "Swing High", shape.triangledown,
          location.abovebar, color.new(COL_BEAR, 20), size=size.tiny)
plotshape(show_swings and not na(swL), "Swing Low",  shape.triangleup,
          location.belowbar, color.new(COL_BULL, 20), size=size.tiny)

plot(show_mm ? mm_target : na, "MM Ziel",
     color=col_mm, linewidth=2, style=plot.style_linebr)

if show_mm and not na(mm_target) and barstate.islast
    mm_lbl = (htf_bias == 1 ? "▲ MM " : "▼ MM ") + str.tostring(mm_target, format.mintick)
    label.new(bar_index, mm_target, mm_lbl,
              color=color.new(col_mm, 70), textcolor=col_mm,
              style=label.style_label_left, size=size.small)

plotshape(is_eq_high, "Equal High (Liquidität)", shape.diamond,
          location.abovebar, color.new(col_eq, 20), size=size.tiny)
plotshape(is_eq_low,  "Equal Low  (Liquidität)", shape.diamond,
          location.belowbar, color.new(col_eq, 20), size=size.tiny)

bgcolor(alignment_pct >= 70 ? color.new(COL_BULL, 95) :
        alignment_pct <= 30 ? color.new(COL_BEAR, 95) : na,
        title="Alignment Background")

// ─── INTRADAY KERZEN-LEVELS (3 konfigurierbare Zeiten) ───────────────────────
// Jede Zone zeigt den 1m-Kerzenkörper zur angegebenen NY-Zeit als Linefill,
// das bis Tagesende verlängert wird. Täglich neu gezeichnet.

var float top_t1 = na
var float bot_t1 = na
var float top_t2 = na
var float bot_t2 = na
var float top_t3 = na
var float bot_t3 = na

var line     ln_t1_top = na
var line     ln_t1_bot = na
var linefill lf_t1     = na
var line     ln_t2_top = na
var line     ln_t2_bot = na
var linefill lf_t2     = na
var line     ln_t3_top = na
var line     ln_t3_bot = na
var linefill lf_t3     = na

if ta.change(time("D")) != 0
    top_t1 := na  ;  bot_t1 := na
    top_t2 := na  ;  bot_t2 := na
    top_t3 := na  ;  bot_t3 := na
    line.delete(ln_t1_top)  ;  line.delete(ln_t1_bot)  ;  linefill.delete(lf_t1)
    line.delete(ln_t2_top)  ;  line.delete(ln_t2_bot)  ;  linefill.delete(lf_t2)
    line.delete(ln_t3_top)  ;  line.delete(ln_t3_bot)  ;  linefill.delete(lf_t3)

if show_t1 and not na(raw_top_t1) and na(top_t1)
    top_t1    := raw_top_t1
    bot_t1    := raw_bot_t1
    ln_t1_top := line.new(bar_index, top_t1, bar_index + 1, top_t1,
                   extend=extend.right, color=col_t1, width=1, style=line.style_dashed)
    ln_t1_bot := line.new(bar_index, bot_t1, bar_index + 1, bot_t1,
                   extend=extend.right, color=col_t1, width=1, style=line.style_dashed)
    lf_t1     := linefill.new(ln_t1_top, ln_t1_bot, color=color.new(col_t1, 88))
    label.new(bar_index, top_t1, "  " + lbl_t1,
              color=color.new(col_t1, 80), textcolor=col_t1,
              style=label.style_label_right, size=size.small)

if show_t2 and not na(raw_top_t2) and na(top_t2)
    top_t2    := raw_top_t2
    bot_t2    := raw_bot_t2
    ln_t2_top := line.new(bar_index, top_t2, bar_index + 1, top_t2,
                   extend=extend.right, color=col_t2, width=1, style=line.style_dashed)
    ln_t2_bot := line.new(bar_index, bot_t2, bar_index + 1, bot_t2,
                   extend=extend.right, color=col_t2, width=1, style=line.style_dashed)
    lf_t2     := linefill.new(ln_t2_top, ln_t2_bot, color=color.new(col_t2, 88))
    label.new(bar_index, top_t2, "  " + lbl_t2,
              color=color.new(col_t2, 80), textcolor=col_t2,
              style=label.style_label_right, size=size.small)

if show_t3 and not na(raw_top_t3) and na(top_t3)
    top_t3    := raw_top_t3
    bot_t3    := raw_bot_t3
    ln_t3_top := line.new(bar_index, top_t3, bar_index + 1, top_t3,
                   extend=extend.right, color=col_t3, width=1, style=line.style_dashed)
    ln_t3_bot := line.new(bar_index, bot_t3, bar_index + 1, bot_t3,
                   extend=extend.right, color=col_t3, width=1, style=line.style_dashed)
    lf_t3     := linefill.new(ln_t3_top, ln_t3_bot, color=color.new(col_t3, 88))
    label.new(bar_index, top_t3, "  " + lbl_t3,
              color=color.new(col_t3, 80), textcolor=col_t3,
              style=label.style_label_right, size=size.small)

// ─── HELPERS ─────────────────────────────────────────────────────────────────

f_label(t) =>
    t == 1 ? "▲ BULL" : t == -1 ? "▼ BEAR" : "● NEUT"

f_col(t) =>
    t == 1 ? COL_BULL : t == -1 ? COL_BEAR : COL_NEUT

_pos(s) =>
    switch s
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        "Top Center"   => position.top_center
        => position.bottom_center

// ─── TABLE ───────────────────────────────────────────────────────────────────
// Row layout:
//   1 header | TF rows (highlighted: orange=context, teal=entry) |
//   1 alignment | 1 dominanz | 4 pairing | 4 stop | 4 mm

var table tbl = na

if barstate.islast
    int rows = 1 + (show_m ? 1 : 0) + (show_w ? 1 : 0) + (show_d ? 1 : 0) + (show_4h ? 1 : 0) + (show_1h ? 1 : 0) + (show_15 ? 1 : 0) + (show_cur ? 1 : 0) + 1 + 1 + 4 + 4 + 4

    tbl := table.new(_pos(tbl_pos), 2, rows,
         bgcolor=COL_BG, border_width=1,
         border_color=color.new(#444466, 60),
         frame_width=1, frame_color=color.new(#666688, 40))

    table.cell(tbl, 0, 0, "TIMEFRAME", text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, 0, "TREND",     text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)

    int row = 1

    if show_m
        table.cell(tbl, 0, row, "Monthly",         text_color=COL_TEXT,         bgcolor=f_lbl_bg("M"), text_size=size.small)
        table.cell(tbl, 1, row, f_label(trend_m),  text_color=f_col(trend_m),   bgcolor=f_val_bg("M"), text_size=size.small)
        row += 1
    if show_w
        table.cell(tbl, 0, row, "Weekly",          text_color=COL_TEXT,         bgcolor=f_lbl_bg("W"), text_size=size.small)
        table.cell(tbl, 1, row, f_label(trend_w),  text_color=f_col(trend_w),   bgcolor=f_val_bg("W"), text_size=size.small)
        row += 1
    if show_d
        table.cell(tbl, 0, row, "Daily",           text_color=COL_TEXT,         bgcolor=f_lbl_bg("D"), text_size=size.small)
        table.cell(tbl, 1, row, f_label(trend_d),  text_color=f_col(trend_d),   bgcolor=f_val_bg("D"), text_size=size.small)
        row += 1
    if show_4h
        table.cell(tbl, 0, row, "4H",              text_color=COL_TEXT,          bgcolor=f_lbl_bg("240"), text_size=size.small)
        table.cell(tbl, 1, row, f_label(trend_4h), text_color=f_col(trend_4h),  bgcolor=f_val_bg("240"), text_size=size.small)
        row += 1
    if show_1h
        table.cell(tbl, 0, row, "1H",              text_color=COL_TEXT,          bgcolor=f_lbl_bg("60"), text_size=size.small)
        table.cell(tbl, 1, row, f_label(trend_1h), text_color=f_col(trend_1h),  bgcolor=f_val_bg("60"), text_size=size.small)
        row += 1
    if show_15
        table.cell(tbl, 0, row, "15m",             text_color=COL_TEXT,          bgcolor=f_lbl_bg("15"), text_size=size.small)
        table.cell(tbl, 1, row, f_label(trend_15), text_color=f_col(trend_15),  bgcolor=f_val_bg("15"), text_size=size.small)
        row += 1
    if show_cur
        cur_lbl_bg = f_lbl_bg(timeframe.period)
        cur_val_bg = f_val_bg(timeframe.period)
        table.cell(tbl, 0, row, "Current (" + timeframe.period + ")",
                   text_color=COL_TEXT, bgcolor=cur_lbl_bg, text_size=size.small)
        table.cell(tbl, 1, row, f_label(trend_cur),
                   text_color=f_col(trend_cur), bgcolor=cur_val_bg, text_size=size.small)
        row += 1

    // Alignment
    aln_col   = alignment_pct >= 70 ? COL_BULL : alignment_pct <= 30 ? COL_BEAR : COL_NEUT
    aln_label = str.tostring(math.round(alignment_pct)) + "% aligned"
    table.cell(tbl, 0, row, "ALIGNMENT", text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, aln_label,   text_color=aln_col,  bgcolor=COL_BG,     text_size=size.small)
    row += 1

    // Dominanz
    table.cell(tbl, 0, row, "DOMINANZ",  text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, dom_str,     text_color=dom_col,  bgcolor=COL_BG,     text_size=size.small)
    row += 1

    // ── TF PAIRING ────────────────────────────────────────────────────────────
    // Shows which HTF to read the bias from and which LTF to time the entry on.
    // Orange = context TF (bias), teal = entry TF (timing).
    table.cell(tbl, 0, row, "TF PAIRING", text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, timeframe.period + " Chart", text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    row += 1

    ctx_val_str = _ctx_lbl + "  " + f_label(_ctx_trend)
    table.cell(tbl, 0, row, "Kontext (HTF)", text_color=COL_TEXT,           bgcolor=COL_CTX, text_size=size.small)
    table.cell(tbl, 1, row, ctx_val_str,     text_color=f_col(_ctx_trend),  bgcolor=COL_CTX, text_size=size.small)
    row += 1

    table.cell(tbl, 0, row, "Entry (LTF)", text_color=COL_TEXT,              bgcolor=COL_ENT, text_size=size.small)
    table.cell(tbl, 1, row, _ent_lbl,      text_color=color.new(#80DEEA, 0), bgcolor=COL_ENT, text_size=size.small)
    row += 1

    table.cell(tbl, 0, row, "Style",     text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, _style_lbl,  text_color=COL_TEXT, bgcolor=COL_BG,     text_size=size.small)
    row += 1

    // ── STOP ──────────────────────────────────────────────────────────────────
    stop_dir_lbl = htf_bias == 1 ? "STOP  ↓ below HL" : htf_bias == -1 ? "STOP  ↑ above LH" : "STOP  (no trend)"
    table.cell(tbl, 0, row, stop_dir_lbl, text_color=COL_STOP, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, "─────────",  text_color=COL_STOP, bgcolor=COL_HEADER, text_size=size.small)
    row += 1

    stop_price_str = not na(stop_level) ? str.tostring(stop_level, format.mintick) : "—"
    table.cell(tbl, 0, row, "Price",        text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, stop_price_str, text_color=COL_STOP, bgcolor=COL_BG,     text_size=size.small)
    row += 1

    dist_pct_str = not na(stop_dist_pct) ? str.tostring(stop_dist_pct, "#.##") + " %" : "—"
    table.cell(tbl, 0, row, "Abstand %",  text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, dist_pct_str, text_color=COL_STOP, bgcolor=COL_BG,     text_size=size.small)
    row += 1

    dist_atr_str = not na(stop_dist_atr) ? str.tostring(stop_dist_atr, "#.##") + " ATR" : "—"
    table.cell(tbl, 0, row, "Abstand ATR", text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, dist_atr_str,  text_color=COL_STOP, bgcolor=COL_BG,     text_size=size.small)
    row += 1

    // ── MM ZIEL ───────────────────────────────────────────────────────────────
    mm_dir_lbl = htf_bias == 1 ? "MM ZIEL  ↑ (Long)" : htf_bias == -1 ? "MM ZIEL  ↓ (Short)" : "MM ZIEL"
    table.cell(tbl, 0, row, mm_dir_lbl,  text_color=col_mm, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, "─────────", text_color=col_mm, bgcolor=COL_HEADER, text_size=size.small)
    row += 1

    mm_price_str = not na(mm_target) ? str.tostring(mm_target, format.mintick) : "—"
    table.cell(tbl, 0, row, "Zielpreis",  text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, mm_price_str, text_color=col_mm,   bgcolor=COL_BG,     text_size=size.small)
    row += 1

    mm_pct_str = not na(mm_dist_pct) ? str.tostring(mm_dist_pct, "#.##") + " %" : "—"
    table.cell(tbl, 0, row, "Distanz %", text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, mm_pct_str,  text_color=col_mm,   bgcolor=COL_BG,     text_size=size.small)
    row += 1

    mm_atr_str = not na(mm_dist_atr) ? str.tostring(mm_dist_atr, "#.##") + " ATR" : "—"
    table.cell(tbl, 0, row, "Distanz ATR", text_color=COL_TEXT, bgcolor=COL_HEADER, text_size=size.small)
    table.cell(tbl, 1, row, mm_atr_str,    text_color=col_mm,   bgcolor=COL_BG,     text_size=size.small)
